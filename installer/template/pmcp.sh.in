#!/bin/ksh
# SPDX-License-Identifier: GPL-3.0-or-later
# pmcp: CarPlay map on the AID for our Passat B8 (MHI2 MU1161, AID 791). Fail-closed installer.
#
#   pmcp.sh verify              read-only: tools, self test, payload hashes, unit state
#   pmcp.sh status              read-only summary (state, variant, Java set, boot log)
#   pmcp.sh install VARIANT     stage A: map video only (dio_manager wrapper); lsd.sh and the HMI stay factory
#   pmcp.sh switch VARIANT      replace only core.so on our own install
#   pmcp.sh java-on NAME        stage B+: add one Java package (JAR) to the HMI set; needs stage A
#   pmcp.sh java-off NAME       remove one Java package; the last one also restores the factory lsd.sh
#   pmcp.sh java-confirm        during the trial boot only: mark the current Java set as good
#   pmcp.sh java-retry          allow one more trial boot of the current Java set
#   pmcp.sh rg-system-on        package E system part: patched iAP2 driver, iap2.cfg [ident], route guidance reader
#   pmcp.sh rg-system-off       factory iAP2 driver and iap2.cfg back
#   pmcp.sh rg-update           RG on with an older pmcp driver/reader (RG_KNOWN): replace them in place by this card's
#                               ones; the factory copies are checked, kept and stay the way back (rg-system-off)
#   pmcp.sh java-update         Java set with packages of an earlier card (JAVA_OLD): one new set with this card's
#                               packages (rglu, rg-aa and the other earlier rg variants become rg), one trial boot
#   pmcp.sh aa-remove           Android Auto off: factory gal back (only from a copy with the factory hash), its files and
#                               markers removed
# Android Auto on the AID (aa/README.md), installed separately from CarPlay (main menu 3, details on aa_advanced):
#   pmcp.sh aa-on               Android Auto: Google Maps picture on the AID + VW arrows (gal wrapper + hook + feeder);
#                               also brings an earlier card's AA set up to date
#   pmcp.sh aa-confirm          during the AA trial start only: keep this AA set
#   pmcp.sh aa-retry            the next AA connection is a new trial
#   pmcp.sh aa-status           read-only: AA state, the last session's stream analysis, the manoeuvres for rg
#   pmcp.sh aa-log-save         copy this start's AA log from /ramdisk to carplaymaps/logs (for the log card)
#   pmcp.sh aa-log-clear        delete the saved AA and CarPlay logs, the recorded phone video and the boot log
#   pmcp.sh aa-output direct|ring  AA 1.0: the AA picture through pmcp's own MOST writer (direct, the set's default) or
#                               the CarPlay bridge (ring, fallback); from the next AA connection, no trial (user
#                               decision A153; the on-unit settings page writes the same line of aa-extra.conf)
# Experimental cards only (pmcp-...-exp-...; aa_advanced):
#   pmcp.sh aa-capture 60|off   record the first 60 s of the phone's video at each AA connection to
#                               /mnt/persist/pmcp/aa-stream.h264 (for the log card)
#   pmcp.sh aa-on-exp           only with a manifest key AAX_FEEDER (an experimental feeder next to the stable one; none
#                               since AA 1.0): that set, its own set id and trial; main menu 3 goes back to stable
#   pmcp.sh speedlimit-mode MODE  optional native VW limit (package sl): off (default); turnto = before the street that rg
#                               writes to TurnToInfo (needs rg); street = trial, in CurrentPositionInfo only
#   pmcp.sh speedlimit-status   read-only saved mode and native-limit reader snapshot
#   pmcp.sh restore             back to the exact factory files
# Main menu (GEM pmcp_stream_map_aid), each repairs its own part and replaces versions this card does not support:
#   pmcp.sh map-install VARIANT 2: factory -> install; ours -> layout VARIANT; mixed map files -> restore, then install
#   pmcp.sh aa-install          3: this card's Android Auto; an unsupported AA set is removed first (aa_off)
#   pmcp.sh features-reset      4 (first step): unsupported route guidance / Java files -> factory, then 4 installs
#   pmcp.sh confirm             5: confirm the Java set and/or the AA set, whichever is in its trial now
#   pmcp.sh retry               6: a new trial for whichever of them is not confirmed
#   pmcp.sh cp-log-save         CarPlay log of this start to carplaymaps/logs (for the log card)
#
# Install/remove actions hash their inputs and require a known unit state. speedlimit-mode off remains available
# independently of those checks, including during a factory fallback boot.
# Stage A never touches the Java HMI, so GEM (and this tool) stays reachable even if the video part fails.
# Java packages load through one fixed lsd.sh block with a trial boot (see build_sd.py LSD_PRE): a new set loads
# once; it stays only if the user confirms it in GEM during that boot (java-confirm), otherwise the next boot is
# factory. carplaymaps/HMI_BOOT ("set-id jar jar ...") is the only file the block reads, replaced with one mv.
# Recovery without GEM: the rescue card (installer/build_rescue.py) undoes the Java part in update mode.
# Runtime layout and wrapper follow omonob/mathsls (binaries expect /mnt/app/carplaymaps).
# Generated by installer/build_sd.py; the manifest block below is part of the build, do not edit by hand.

PMCP_VERSION="@@PMCP_VERSION@@"
MANIFEST='
@@MANIFEST@@
'
SELFTEST_SHA="@@SELFTEST_SHA@@"
SELFTEST_SIZE="@@SELFTEST_SIZE@@"
STOCK_JXE_SIZE=55830309
STOCK_LSD_SHA="@@STOCK_LSD_SHA@@"
STOCK_LSD_SIZE="@@STOCK_LSD_SIZE@@"
STOCK_DIO_SHA="@@STOCK_DIO_SHA@@"
STOCK_DIO_SIZE="@@STOCK_DIO_SIZE@@"
STOCK_DRV_SHA="@@STOCK_DRV_SHA@@"
STOCK_DRV_SIZE="@@STOCK_DRV_SIZE@@"
STOCK_CFG_SHA="@@STOCK_CFG_SHA@@"
STOCK_CFG_SIZE="@@STOCK_CFG_SIZE@@"
STOCK_GAL_SHA="@@STOCK_GAL_SHA@@"
STOCK_GAL_SIZE="@@STOCK_GAL_SIZE@@"
# Every SHA-256 above (manifest, IDs, factory files) -> the SHA-1 the unit actually computes (factory sha1sum, hash_of).
# Both are computed by build_sd.py from the same bytes; the self test proves the unit tool before any hash is trusted.
HASHMAP='
@@HASHMAP@@
'
# Earlier pmcp route guidance files this card may replace with rg-update ("DRIVER|READER sha256 size" per line).
RG_KNOWN='
@@RG_KNOWN@@
'
# Java packages of earlier cards that java-update replaces ("name sha256 size jarfile newname" per line).
JAVA_OLD='
@@JAVA_OLD@@
'
# AA sets of earlier cards ("mode hook-sha size feeder-sha size hookconf-sha size feederconf-sha size" per line, aa_state)
AA_OLD='
@@AA_OLD@@
'
GAWK_SIZE=487088

ACTION="$1"
ARG="$2"

SD="${0%/*}"
[ "$SD" = "$0" ] && SD="."
PAYLOAD="$SD/payload"

export PATH=/proc/boot:/bin:/usr/bin:/usr/sbin:/sbin:/mnt/app/armle/bin:/mnt/app/armle/sbin:/mnt/app/armle/usr/bin:/mnt/app/armle/usr/sbin
export LD_LIBRARY_PATH=/lib:/mnt/app/root/lib-target:/eso/lib:/mnt/app/usr/lib:/mnt/app/armle/lib:/mnt/app/armle/lib/dll:/mnt/app/armle/usr/lib
unset LD_PRELOAD
export LC_ALL=C LANG=C

if [ -n "${PMCP_TEST_ROOT:-}" ]; then
    MMX="$PMCP_TEST_ROOT"
    LOGDIR="$PMCP_TEST_ROOT/sdlog"
elif [ -s /ifs/lsd.jxe ] && [ -d /mnt/app/eso ]; then
    MMX=""
    LOGDIR="$SD/log"
elif [ -s /net/mmx/ifs/lsd.jxe ] && [ -d /net/mmx/mnt/app/eso ]; then
    MMX="/net/mmx"
    LOGDIR="$SD/log"
else
    echo "PMCP_FAIL=MMX_FILESYSTEM_NOT_FOUND"
    exit 1
fi

APP="$MMX/mnt/app"
JXE="$MMX/ifs/lsd.jxe"
DIO="$APP/eso/bin/apps/dio_manager"
LSD="$APP/eso/hmi/lsd/lsd.sh"
JARS="$APP/eso/hmi/lsd/jars"
ROOT="$APP/carplaymaps"
PERSIST="$MMX/mnt/persist/pmcp"
SL_MODE="$PERSIST/native-speedlimit-mode"
SL_STATE="$MMX/ramdisk/pmcp-speedlimit.state"
SL_LOCK="$MMX/ramdisk/pmcp-speedlimit.lock"
DRV="$APP/armle/lib/dll/ipod-drvr-iap2.so"
CFG="$MMX/mnt/system/etc/mm/iap2.cfg"
RGDIR="$ROOT/rg"
GAL="$APP/eso/bin/apps/gal"
AADIR="$ROOT/aa"
RAMDISK="$MMX/ramdisk"
GAWK="$APP/armle/usr/bin/gawk"
if [ -z "$MMX" ]; then SHA1=/net/rcc/usr/bin/sha1sum; else SHA1=/usr/bin/sha1sum; fi

# The SD card is mounted read-only outside update mode. In GEM on MU1161 even the remount fails (diagnostics
# 2026-10-23: "Can't remount ... Read-only file system"), so there the screen (photographed) is the log.
if [ -z "${PMCP_TEST_ROOT:-}" ]; then
    mount -uw "${SD%/*}" >/dev/null 2>&1 || true
fi
mkdir -p "$LOGDIR" 2>/dev/null
LOG="$LOGDIR/pmcp-$ACTION-$$.log"
( : >> "$LOG" ) 2>/dev/null || LOG=""   # subshell: a failed redirect on the special builtin ":" would end the script

# A152: the SD log never works in GEM (read-only card), so every button's output also goes to the unit:
# $PERSIST/gem.log, at most ~2 x 32 KB (gem.log.1 = the older half). Only once pmcp made $PERSIST (a fresh unit stays
# untouched); restore removes $PERSIST and with it this log; the log card copies it, aa-log-clear deletes it.
GEMLOG="${PMCP_TEST_GEMLOG:-$PERSIST/gem.log}"
if [ -d "${GEMLOG%/*}" ]; then
    _g_l=`ls -ln "$GEMLOG" 2>/dev/null` && set -- $_g_l
    case "${5:-0}" in *[!0-9]*) ;; *) if [ "${5:-0}" -gt 32768 ]; then   # bounded even when the move fails
        mv -f "$GEMLOG" "$GEMLOG.1" 2>/dev/null || rm -f "$GEMLOG" 2>/dev/null; fi ;; esac
    { echo "=== $PMCP_VERSION $ACTION $ARG `date 2>/dev/null`" >> "$GEMLOG"; } 2>/dev/null || GEMLOG=""
else
    GEMLOG=""
fi
set --
[ -n "$LOG" ] || [ -n "$GEMLOG" ] || echo "PMCP_WARN=NO_LOG_WRITABLE (photograph the screen)"

say() {
    echo "$*"
    [ -n "$LOG" ] && { echo "$*" >> "$LOG"; } 2>/dev/null
    [ -n "$GEMLOG" ] && { echo "$*" >> "$GEMLOG"; } 2>/dev/null
    return 0
}

fail() {
    say "PMCP_FAIL=$1"
    say "Nothing after this point was done."
    exit 1
}

# Serialize mode changes with Java-set changes. Only the successful mkdir owner installs cleanup.
# /ramdisk exists on MMX and disappears at reboot, including a lock left by sudden power loss.
# Only the actions that write the mode or change the package list take it: java-confirm, java-retry and restore
# never wait for it, so a lock left by a killed script cannot block the way back (it goes at the next start).
speedlimit_lock() {
    mkdir "$SL_LOCK" 2>/dev/null || fail "SPEEDLIMIT_LOCK_BUSY_OR_RAMDISK_UNAVAILABLE"
    trap 'rm -f "$SL_MODE.pmcp-new" 2>/dev/null; rm -rf "$SL_LOCK" 2>/dev/null' 0
    trap 'exit 1' 1 2 15
}

clear_speedlimit_mode() {
    rm -f "$SL_MODE" "$SL_MODE.pmcp-new" || fail "SPEEDLIMIT_MODE_REMOVE_FAILED"
}

# ---------------------------------------------------------------- hashing
# gawk runs on MMX (where it lives); paths are passed in MMX view. Test mode runs a host gawk.
mmx_path() {
    if [ -n "$MMX" ] && [ -z "${PMCP_TEST_ROOT:-}" ]; then
        echo "${1#$MMX}"
    else
        echo "$1"
    fi
}

# hash_of FILE -> prints "sha1 size" or nothing
# Shell functions here have no local variables: every helper uses its own _prefix_ names, so it can never
# overwrite a caller's variable (a shared "f" once made java-on stage a JAR under another JAR's name).
# The factory RCC sha1sum (compiled; gawk SHA-256 ran at ~10-20 KB/s) also runs on MMX: GEM diagnostics 2026-10-23 S4
# gave the right SHA-1 for selftest.bin when started from MMX as /net/rcc/usr/bin/sha1sum. Via `on -f rcc` it failed
# (GEM LD_PRELOAD), so it is never started that way.
hash_of() {
    _h_p=$1
    if [ -n "${PMCP_TEST_ROOT:-}" ]; then
        _h_o=`shasum -a 1 "$_h_p" 2>/dev/null`
    else
        _h_o=`"$SHA1" "$_h_p" 2>/dev/null`
    fi
    set -- $_h_o
    _h_z=`size_of "$_h_p"`
    [ -n "$1" ] && [ -n "$_h_z" ] && echo "$1 $_h_z"
}

# sha1_for SHA256 -> the SHA-1 of the same file (HASHMAP), or nothing
sha1_for() {
    echo "$HASHMAP" | while read _q_a _q_b; do [ "$_q_a" = "$1" ] && echo "$_q_b"; done
}

# check FILE SHA SIZE LABEL -> fails closed on any mismatch
check() {
    [ -f "$1" ] || fail "MISSING_$4"
    _c_want=`sha1_for "$2"`
    [ -n "$_c_want" ] || fail "NO_SHA1_FOR_$4"
    _c_got=`hash_of "$1"`
    if [ "$_c_got" != "$_c_want $3" ]; then
        say "  $4: expected $_c_want ($3 B), got ${_c_got:-nothing}"
        fail "HASH_MISMATCH_$4"
    fi
    say "  ok $4"
}

# same as check, but only answers yes/no (size first: hashing big files on the unit is slow)
matches() {
    [ -f "$1" ] || return 1
    [ "`size_of "$1"`" = "$3" ] || return 1
    _m_want=`sha1_for "$2"`
    [ -n "$_m_want" ] || return 1
    _m_got=`hash_of "$1"`
    [ "$_m_got" = "$_m_want $3" ]
}

manifest_get() {
    # manifest_get KEY -> "sha size relpath"
    echo "$MANIFEST" | while read _g_k _g_h _g_s _g_p; do
        [ "$_g_k" = "$1" ] && echo "$_g_h $_g_s $_g_p"
    done
}

# Java packages known to this build, in manifest order: "name jarfile" per line
java_catalog() {
    echo "$MANIFEST" | while read _k_k _k_h _k_s _k_p; do
        case "$_k_k" in JAR_*) echo "${_k_k#JAR_} ${_k_p##*/}" ;; esac
    done
}

# java_old NAME SHA8 -> "sha size jarfile newname" of an earlier card's package, or nothing
java_old() {
    echo "$JAVA_OLD" | while read _o_n _o_h _o_s _o_f _o_t; do
        [ "$_o_n" = "$1" ] && [ "`first8 $_o_h`" = "$2" ] && echo "$_o_h $_o_s $_o_f $_o_t"
    done
}

java_jarfile() {
    java_catalog | while read _w_n _w_f; do [ "$_w_n" = "$1" ] && echo "$_w_f"; done
}

# first8 SHA -> first 8 characters, with shell builtins only (no cut on the unit)
first8() {
    _f_x=$1; _f_rest=${_f_x#????????}; echo "${_f_x%"$_f_rest"}"
}

size_of() {
    _z_line=`ls -ln "$1" 2>/dev/null` || return 1
    set -- $_z_line
    echo "$5"
}

# ---------------------------------------------------------------- checks
# Every external command this script uses must exist before anything is written (PieWhite saw tr/cksum
# missing in the MU1367 GEM shell; we use neither, but check what we do use).
tools_present() {
    say "Tools"
    for t in cp mv rm mkdir chmod touch ls cat; do
        type "$t" >/dev/null 2>&1 || fail "TOOL_MISSING_$t"
    done
    if [ -z "${PMCP_TEST_ROOT:-}" ]; then
        for t in mount slay; do type "$t" >/dev/null 2>&1 || fail "TOOL_MISSING_$t"; done
        if [ -n "$MMX" ]; then type on >/dev/null 2>&1 || fail "TOOL_MISSING_on"; fi
        [ -x "$SHA1" ] || fail "TOOL_MISSING_sha1sum"
    fi
    say "  ok"
}

selftest() {
    tools_present
    say "Self test (sha1sum on this unit)"
    check "$SD/bin/selftest.bin" "$SELFTEST_SHA" "$SELFTEST_SIZE" SELFTEST
}

# flush: the files live on MMX, so sync there (RCC may have no sync, and its sync would not flush MMX's cache)
flush() {
    if [ -n "$MMX" ] && [ -z "${PMCP_TEST_ROOT:-}" ]; then
        on -f mmx sync >/dev/null 2>&1 || true
    else
        sync >/dev/null 2>&1 || true
    fi
}

# read-only again after writing /mnt/system (best effort; the next boot mounts it read-only anyway)
remount_sys_ro() {
    if [ -n "${PMCP_TEST_ROOT:-}" ]; then
        :
    elif [ -n "$MMX" ]; then
        on -f mmx mount -ur /mnt/system >/dev/null 2>&1 || true
    else
        mount -ur /mnt/system >/dev/null 2>&1 || true
    fi
}

# Loops over the manifest in this shell (heredoc, no temp file: an unwritable log dir must not skip the checks).
verify_payload() {
    say "Payload on SD"
    _v_n=0
    while read k h s p; do
        [ -n "$k" ] || continue
        check "$PAYLOAD/$p" "$h" "$s" "$k"
        _v_n=$((_v_n + 1))
    done <<EOF
$MANIFEST
EOF
    [ "$_v_n" -gt 0 ] || fail "EMPTY_MANIFEST"
    say "  $_v_n payload files ok"
}

firmware_identity() {
    say "Firmware identity"
    [ -s "$JXE" ] || fail "LSD_JXE_MISSING"
    [ "`size_of "$JXE"`" = "$STOCK_JXE_SIZE" ] || fail "NOT_MU1161_LSD_JXE_SIZE_`size_of "$JXE"`"
    say "  ok lsd.jxe size $STOCK_JXE_SIZE (MU1161)"
}

# Our JAR files (this card's and earlier cards') present in the HMI jars directory, one file name per line
our_jars_present() {
    { java_catalog | while read _o_n _o_f; do echo "$_o_f"; done
      echo "$JAVA_OLD" | while read _o_n _o_h _o_s _o_f _o_t; do [ -n "$_o_f" ] && echo "$_o_f"; done
    } | while read _o_f; do [ -e "$JARS/$_o_f" ] && echo "$_o_f"; done
}

# carplaymaps/HMI_BOOT: one line "SET_ID JAR JAR ...", the only file lsd.sh reads. SET_ID is name-sha8 joined by "+",
# so the package names come from it: one file, one mv, the id and the JAR list can never disagree at boot.
boot_set_id() {
    [ -s "$ROOT/HMI_BOOT" ] || return 0
    read _b_id _b_rest < "$ROOT/HMI_BOOT"
    echo "$_b_id"
}

# Current Java set: package names, space separated, in set order
current_set() {
    _n_x=`boot_set_id`
    [ -n "$_n_x" ] || return 0
    _n_out=""
    while :; do
        _n_part=${_n_x%%+*}
        _n_out="$_n_out${_n_out:+ }${_n_part%-*}"
        [ "$_n_part" = "$_n_x" ] && break
        _n_x=${_n_x#*+}
    done
    echo "$_n_out"
}

# Every part "name-sha8" of the set id is a package of this card (manifest) or of an earlier card (JAVA_OLD), its JAR is
# present with that hash, and HMI_BOOT is exactly "id jars". Only then: JAVA_OLD_SET = the names of earlier cards'
# packages in the set (java-update replaces them), JAVA_STRAY = JAR files of ours the set does not list (left by an
# interrupted java-on/java-update; never loaded, since the lsd.sh block loads only the HMI_BOOT list; java-update and
# restore remove them).
java_set_consistent() {
    JAVA_OLD_SET=""; JAVA_STRAY=""
    _j_id=`boot_set_id`
    [ -n "$_j_id" ] || return 1
    _j_x=$_j_id; _j_jars=""; _j_old=""
    while :; do
        _j_part=${_j_x%%+*}
        _j_n=${_j_part%-*}; _j_8=${_j_part##*-}
        set -- `manifest_get "JAR_$_j_n"`
        if [ -n "$1" ] && [ "`first8 $1`" = "$_j_8" ]; then
            _j_f=${3##*/}
        else
            set -- `java_old "$_j_n" "$_j_8"`
            [ -n "$1" ] || return 1
            _j_f=$3; _j_old="$_j_old${_j_old:+ }$_j_n"
        fi
        matches "$JARS/$_j_f" "$1" "$2" || return 1
        _j_jars="$_j_jars${_j_jars:+ }$_j_f"
        [ "$_j_part" = "$_j_x" ] && break
        _j_x=${_j_x#*+}
    done
    [ "`cat "$ROOT/HMI_BOOT" 2>/dev/null`" = "$_j_id $_j_jars" ] || return 1
    _j_stray=""
    for _j_f in `our_jars_present`; do
        case " $_j_jars " in *" $_j_f "*) ;; *) _j_stray="$_j_stray${_j_stray:+ }$_j_f" ;; esac
    done
    JAVA_OLD_SET=$_j_old; JAVA_STRAY=$_j_stray
    return 0
}

# AA 1.0 (A153, conditions of the CP review): Android Auto never touches the Java part, so main menu 3 does not wait for
# 4 when only the Java part is of a version this card does not support (e.g. a package this card does not know), and
# only when that part is plainly ours: map and route guidance system fine, lsd.sh factory or ours, and with ours the set
# file names exactly one existing plain JAR per package, each ours by name (pmcp-*.jar) or known to this card.
java_part_tolerable() {
    [ "$MAPOK" = yes ] && [ "$RGSYS" != unknown ] && [ "$JAVAPART" = mixed ] || return 1
    matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" && return 0
    set -- `manifest_get LSD_JAVA`
    matches "$LSD" "$1" "$2" || return 1
    _t_line=`cat "$ROOT/HMI_BOOT" 2>/dev/null`
    _t_known=`java_catalog | while read _t_a _t_f; do echo "$_t_f"; done; echo "$JAVA_OLD" | while read _t_a _t_b _t_c _t_f _t_d; do echo "$_t_f"; done`
    set -f
    set -- $_t_line
    _t_id=$1
    case "$_t_id" in ""|*[!A-Za-z0-9+-]*) set +f; return 1 ;; esac
    shift
    _t_n=1; _t_x=$_t_id
    while [ "${_t_x#*+}" != "$_t_x" ]; do _t_x=${_t_x#*+}; _t_n=$((_t_n + 1)); done
    [ $# -eq $_t_n ] || { set +f; return 1; }
    _t_seen=" "
    for _t_w in "$@"; do
        case "$_t_w" in *[!A-Za-z0-9._-]*|.*) set +f; return 1 ;; esac
        case "$_t_seen" in *" $_t_w "*) set +f; return 1 ;; esac
        _t_seen="$_t_seen$_t_w "
        [ -f "$JARS/$_t_w" ] && [ ! -h "$JARS/$_t_w" ] || { set +f; return 1; }
        case "$_t_w" in
            pmcp-*.jar) ;;
            *) case " `echo $_t_known` " in *" $_t_w "*) ;; *) set +f; return 1 ;; esac ;;
        esac
    done
    set +f
    return 0
}

# state -> STOCK | VIDEO | JAVA | PARTIAL | UNKNOWN (reason in STATE_WHY)
#   VIDEO: stage A (wrapper active, factory lsd.sh, no JAR of ours)   JAVA: stage A + lsd.sh block + a consistent JAR set
detect_state() {
    STATE=UNKNOWN; STATE_WHY=""; RGSYS=unknown; JAVA_OLD_SET=""; JAVA_STRAY=""; AASYS=unknown; AAMODE=""
    CORE_STATE=UNKNOWN; MAPOK=no; JAVAPART=mixed
    set -- `manifest_get WRAPPER`; W_SHA=$1; W_SIZE=$2
    set -- `manifest_get LSD_JAVA`; LJ_SHA=$1; LJ_SIZE=$2
    present=`our_jars_present`
    if [ ! -e "$ROOT" ] && [ -z "$present" ] && [ ! -e "$JARS/CarPlayNavigationPatch.jar" ] && [ ! -e "$JARS/CarPlayClusterControls.jar" ]; then
        if matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" && matches "$DIO" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" \
            && matches "$DRV" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" && matches "$CFG" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE" \
            && matches "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE"; then
            STATE=STOCK; CORE_STATE=STOCK; RGSYS=off; AASYS=off; return
        fi
        STATE_WHY="no carplaymaps, but lsd.sh, dio_manager, gal, the iAP2 driver or iap2.cfg is not the factory file"
        return
    fi
    if [ -e "$JARS/CarPlayNavigationPatch.jar" ] \
        || ! [ -s "$ROOT/PMCP_VERSION" ] \
        || ! matches "$ROOT/stock_first/dio_manager.real" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" \
        || ! matches "$ROOT/rollback/lsd.sh" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE"; then
        STATE_WHY="carplaymaps or a navigation JAR exists, but it is not a pmcp install (another mod?)"
        return
    fi
    # RGSYS old (RG on with an earlier card's driver/reader) works as it is; rg-update brings this card's files
    rg_state
    aa_state
    # the three parts, each repaired by its own main-menu button: map (2), Android Auto (3), features (4)
    MAPOK=no; JAVAPART=mixed
    matches "$DIO" "$W_SHA" "$W_SIZE" && MAPOK=yes
    if [ -z "$present" ] && matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE"; then
        JAVAPART=none
    elif matches "$LSD" "$LJ_SHA" "$LJ_SIZE" && java_set_consistent; then
        JAVAPART=set
    fi
    CORE_STATE=PARTIAL
    if [ $MAPOK = yes ] && [ "$RGSYS" != unknown ]; then
        case $JAVAPART in none) CORE_STATE=VIDEO ;; set) CORE_STATE=JAVA ;; esac
    fi
    if [ "$CORE_STATE" != PARTIAL ] && [ "$AASYS" != unknown ]; then
        STATE=$CORE_STATE; return
    fi
    STATE=PARTIAL
    if [ $MAPOK = no ]; then
        STATE_WHY="pmcp factory copies are intact, the CarPlay map files are mixed (interrupted action): main menu, 2. Install CarPlay repairs it (it removes everything first), or 8. Remove everything"
    elif [ "$CORE_STATE" = PARTIAL ]; then
        STATE_WHY="route guidance or Java files are mixed or of a version this card does not support (interrupted action, rescue card or another card): main menu, 4. Install additional features replaces them"
        [ "$AASYS" = unknown ] && STATE_WHY="$STATE_WHY; Android Auto files too: then 3. Install Android Auto"
    else
        # only the Android Auto files: an interrupted AA install, or an AA set this card does not support
        STATE_WHY="Android Auto files are mixed or of a version this card does not support: main menu, 3. Install Android Auto replaces them (CarPlay stays as it is)"
    fi
}

# carplaymaps is our install: version file, verified factory dio_manager and lsd.sh copies, no other navigation mod
pmcp_root() {
    [ -s "$ROOT/PMCP_VERSION" ] && [ ! -e "$JARS/CarPlayNavigationPatch.jar" ] \
        && matches "$ROOT/stock_first/dio_manager.real" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" \
        && matches "$ROOT/rollback/lsd.sh" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE"
}

# Android Auto (aa-on, this card or an earlier one): gal replaced by its wrapper, carplaymaps/aa with the factory gal copy
# gal.real, or leftovers of an interrupted aa-on / aa-off (.aa-new, gal.pmcp-new, gal.pmcp-restore).
# Its saved logs (carplaymaps/logs/aa-log-*) are left alone: harmless, and restore removes carplaymaps anyway.
aa_present() {
    [ -e "$ROOT/aa" ] || [ -e "$ROOT/.aa-new" ] || [ -e "$GAL.pmcp-new" ] || [ -e "$GAL.pmcp-restore" ] \
        || ! matches "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE"
}

# aa_off: factory gal back (staged from carplaymaps/aa/gal.real, which must have the factory hash), then the AA files
# and markers go. Fails before any write when gal is not factory and no verified copy exists. Idempotent: an interrupted
# run is finished by running it again (gal is factory then, so no copy is needed).
aa_off() {
    if ! matches "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE"; then
        matches "$ROOT/aa/gal.real" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" || fail "AA_REMOVE_FACTORY_GAL_COPY_NOT_VERIFIED"
    fi
    remount_rw
    rm -f "$GAL.pmcp-new" "$GAL.pmcp-restore" 2>/dev/null
    if ! matches "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE"; then
        cp "$ROOT/aa/gal.real" "$GAL.pmcp-restore" && chmod 755 "$GAL.pmcp-restore" || fail "GAL_RESTORE_STAGE_FAILED"
        check "$GAL.pmcp-restore" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" STAGED_FACTORY_GAL
        mv "$GAL.pmcp-restore" "$GAL" || fail "GAL_RESTORE_FAILED_RUN_AA_REMOVE_AGAIN"
    fi
    check "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" FACTORY_GAL
    [ -x "$GAL" ] || fail "FACTORY_GAL_NOT_EXECUTABLE"
    rm -rf "$ROOT/aa" "$ROOT/.aa-new" 2>/dev/null
    [ ! -e "$ROOT/aa" ] && [ ! -e "$ROOT/.aa-new" ] || fail "AA_DIR_REMOVE_FAILED_RUN_AA_REMOVE_AGAIN"
    rm -f "$PERSIST"/aa-trial.* "$PERSIST"/aa-ok.* "$PERSIST/aa-capture" "$PERSIST/AA_DISABLED" 2>/dev/null
    rm -f "$PERSIST/aa-extra.conf" "$PERSIST"/aa-extra.conf.pmcp-new "$PERSIST"/aa-stream.h264* 2>/dev/null
}

do_aa_remove() {
    selftest
    firmware_identity
    [ -d "$ROOT" ] || fail "AA_REMOVE_ALREADY_NOT_INSTALLED"
    aa_present || fail "AA_REMOVE_ALREADY_NOT_INSTALLED"
    pmcp_root || fail "AA_REMOVE_NOT_A_PMCP_INSTALL"
    aa_off
    flush
    detect_state
    say "PMCP_AA_REMOVE_OK (factory gal verified; unit state now: $STATE)"
    say "Restart the unit before connecting an Android phone again."
}


# ---- Android Auto ------------------------------------------------------------------------------------------------------
# One mode, gamma: the gamma hook (Google Maps manoeuvres -> rg mailbox /ramdisk/pmcp-aa-rg), the feeder with start sync
# and pacing, protocol 1.7. AA set id = mode and the first 8 hex of hook, feeder and hook settings (the same formula as on
# the earlier cards, so their confirm markers keep their meaning).
aa_set_id() {
    # gammax = the experimental set of an experimental card: AAX_FEEDER instead of AA_FEEDER, the same "gamma" prefix
    # (the wrapper only compares the whole id with its markers)
    _i_id="$1"; _i_fk=AA_FEEDER
    [ "$1" = gammax ] && { _i_id=gamma; _i_fk=AAX_FEEDER; }
    for _i_k in AA_HOOK $_i_fk AA_HOOK_CONF; do
        set -- `manifest_get $_i_k`
        _i_id="$_i_id-`first8 $1`"
    done
    echo "$_i_id"
}

# AASYS -> off (factory gal, no aa/, no leftovers) | on (wrapper active, factory gal copy, hook, feeder, settings and
# AA_BOOT of this card; AAMODE = gamma) | old (the same, but the whole set of one AA_OLD line with its own AA_BOOT: an
# earlier card's set, also of its other modes; aa-on replaces it) | unknown
aa_state() {
    AASYS=unknown; AAMODE=""
    if [ ! -e "$AADIR" ] && [ ! -e "$ROOT/.aa-new" ] && [ ! -e "$GAL.pmcp-new" ] && [ ! -e "$GAL.pmcp-restore" ] \
        && matches "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE"; then
        AASYS=off; return 0
    fi
    set -- `manifest_get AA_WRAPPER`
    matches "$GAL" "$1" "$2" || return 0
    matches "$AADIR/gal.real" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" || return 0
    set -- `manifest_get AA_DMDT_FLUSH`
    matches "$AADIR/libdmdt_flush.so" "$1" "$2" || return 0
    _a_boot=`cat "$AADIR/AA_BOOT" 2>/dev/null`
    _a_ok=yes
    for _a_k in AA_HOOK:libgal_hook.so AA_FEEDER:aa-most-feeder AA_HOOK_CONF:gal-hook.conf AA_MODE:feeder.conf; do
        set -- `manifest_get ${_a_k%%:*}`
        matches "$AADIR/${_a_k#*:}" "$1" "$2" || _a_ok=no
    done
    if [ $_a_ok = yes ]; then
        [ "$_a_boot" = "`aa_set_id gamma`" ] || return 0
        AASYS=on; AAMODE=gamma
        return 0
    fi
    # experimental cards: their experimental set (AAMODE gammax), whole, with its own AA_BOOT
    if [ -n "`manifest_get AAX_FEEDER`" ]; then
        _a_ok=yes
        for _a_k in AA_HOOK:libgal_hook.so AAX_FEEDER:aa-most-feeder AA_HOOK_CONF:gal-hook.conf AA_MODE:feeder.conf; do
            set -- `manifest_get ${_a_k%%:*}`
            matches "$AADIR/${_a_k#*:}" "$1" "$2" || _a_ok=no
        done
        if [ $_a_ok = yes ]; then
            [ "$_a_boot" = "`aa_set_id gammax`" ] || return 0
            AASYS=on; AAMODE=gammax
            return 0
        fi
    fi
    # an earlier card's set, whole (never a mix of files from different sets), with that set's own AA_BOOT
    while read _o_m _o_hs _o_hz _o_fs _o_fz _o_cs _o_cz _o_ms _o_mz; do
        [ -n "$_o_mz" ] || continue
        [ "$_a_boot" = "$_o_m-`first8 $_o_hs`-`first8 $_o_fs`-`first8 $_o_cs`" ] || continue
        matches "$AADIR/libgal_hook.so" "$_o_hs" "$_o_hz" || continue
        matches "$AADIR/aa-most-feeder" "$_o_fs" "$_o_fz" || continue
        matches "$AADIR/gal-hook.conf" "$_o_cs" "$_o_cz" || continue
        matches "$AADIR/feeder.conf" "$_o_ms" "$_o_mz" || continue
        AASYS=old; AAMODE=$_o_m
        break
    done <<EOF
$AA_OLD
EOF
    return 0
}

aa_check_payload() {    # [gammax]: the experimental feeder too
    _p_x=""; [ "$1" = gammax ] && _p_x=AAX_FEEDER
    for _p_k in AA_WRAPPER AA_HOOK AA_DMDT_FLUSH AA_FEEDER AA_HOOK_CONF AA_MODE $_p_x; do
        set -- `manifest_get $_p_k`
        check "$PAYLOAD/$3" "$1" "$2" "$_p_k"
    done
}

do_aa_on() {
    case "${ARG:-gamma}" in
        gamma) ARG=gamma; _o_fk=AA_FEEDER ;;
        gammax) [ -n "`manifest_get AAX_FEEDER`" ] || fail "AA_EXPERIMENTAL_NOT_ON_THIS_CARD"; _o_fk=AAX_FEEDER ;;
        *) fail "AA_MODE_UNKNOWN_$ARG" ;;
    esac
    selftest
    firmware_identity
    detect_state
    case "$STATE" in
        VIDEO|JAVA) ;;
        # AA 1.0: only the Java part unsupported and plainly ours (java_part_tolerable): AA leaves it as it is
        PARTIAL) [ "$AASYS" != unknown ] && [ "$CORE_STATE" = PARTIAL ] && java_part_tolerable || fail "AA_NEEDS_STAGE_A_STATE_$STATE" ;;
        *) fail "AA_NEEDS_STAGE_A_STATE_$STATE" ;;
    esac
    [ "$AASYS" = on ] && [ "$AAMODE" = "$ARG" ] && fail "AA_ALREADY_ON"
    aa_check_payload $ARG
    set -- `manifest_get AA_MODE`; M_SHA=$1; M_SIZE=$2; M_PATH=$3
    set -- `manifest_get $_o_fk`; F_SHA=$1; F_SIZE=$2; F_PATH=$3
    set -- `manifest_get AA_HOOK_CONF`; C_SHA=$1; C_SIZE=$2; C_PATH=$3
    set -- `manifest_get AA_HOOK`; K_SHA=$1; K_SIZE=$2; K_PATH=$3
    SET=`aa_set_id $ARG`
    remount_rw
    if [ "$AASYS" = old ] || [ "$AASYS" = on ]; then
        # an earlier card's set brought up to date, or (experimental cards) the stable and the experimental set swapped:
        # the four files staged and verified, then the new set id (a new id always means a trial start), then the files
        A="${AADIR:?}"
        rm -f "$A/feeder.conf.pmcp-new" "$A/aa-most-feeder.pmcp-new" "$A/gal-hook.conf.pmcp-new" \
            "$A/libgal_hook.so.pmcp-new" "$A/AA_BOOT.pmcp-new" "$A/AA_BOOT.pmcp-empty" 2>/dev/null
        cp "$PAYLOAD/$M_PATH" "$A/feeder.conf.pmcp-new" && chmod 644 "$A/feeder.conf.pmcp-new" || fail "AA_MODE_STAGE_FAILED"
        cp "$PAYLOAD/$F_PATH" "$A/aa-most-feeder.pmcp-new" && chmod 755 "$A/aa-most-feeder.pmcp-new" || fail "AA_FEEDER_STAGE_FAILED"
        cp "$PAYLOAD/$C_PATH" "$A/gal-hook.conf.pmcp-new" && chmod 644 "$A/gal-hook.conf.pmcp-new" || fail "AA_HOOK_CONF_STAGE_FAILED"
        cp "$PAYLOAD/$K_PATH" "$A/libgal_hook.so.pmcp-new" && chmod 644 "$A/libgal_hook.so.pmcp-new" || fail "AA_HOOK_STAGE_FAILED"
        check "$A/libgal_hook.so.pmcp-new" "$K_SHA" "$K_SIZE" STAGED_AA_HOOK
        check "$A/feeder.conf.pmcp-new" "$M_SHA" "$M_SIZE" STAGED_AA_MODE
        check "$A/aa-most-feeder.pmcp-new" "$F_SHA" "$F_SIZE" STAGED_AA_FEEDER
        check "$A/gal-hook.conf.pmcp-new" "$C_SHA" "$C_SIZE" STAGED_AA_HOOK_CONF
        # Every AA confirmation and trial marker goes before anything changes: the set id does not cover feeder.conf (an
        # earlier set with the same id, 030b7df2: same hook, feeder and hook settings, 2 Mbit/s, is still a different
        # set), and a marker of the NEW id can exist from an earlier change (A150). The new set always gets a trial.
        rm -f "$PERSIST"/aa-ok.* "$PERSIST"/aa-trial.* "$RAMDISK"/pmcp-aa-trial.* 2>/dev/null
        for _o_m in "$PERSIST"/aa-ok.* "$PERSIST"/aa-trial.* "$RAMDISK"/pmcp-aa-trial.*; do
            [ -e "$_o_m" ] && fail "AA_MARKER_REMOVE_FAILED"
        done
        echo "$SET" > "$A/AA_BOOT.pmcp-new" || fail "AA_SET_STAGE_FAILED"
        [ "`cat "$A/AA_BOOT.pmcp-new" 2>/dev/null`" = "$SET" ] || fail "AA_SET_STAGE_READBACK_FAILED"
        # AA_BOOT empty while the files change (the gal wrapper runs the factory gal for an empty AA_BOOT, and a mix of
        # files is no known set for status), the new id only after the last file (A150)
        : > "$A/AA_BOOT.pmcp-empty" || fail "AA_SET_STAGE_FAILED"
        mv "$A/AA_BOOT.pmcp-empty" "$A/AA_BOOT" || fail "AA_SET_DEACTIVATION_FAILED_RUN_AA_REMOVE"
        [ -s "$A/AA_BOOT" ] && fail "AA_SET_DEACTIVATION_FAILED_RUN_AA_REMOVE"
        mv "$A/libgal_hook.so.pmcp-new" "$A/libgal_hook.so" || fail "AA_HOOK_ACTIVATION_FAILED_RUN_AA_REMOVE"
        mv "$A/aa-most-feeder.pmcp-new" "$A/aa-most-feeder" || fail "AA_FEEDER_ACTIVATION_FAILED_RUN_AA_REMOVE"
        mv "$A/gal-hook.conf.pmcp-new" "$A/gal-hook.conf" || fail "AA_HOOK_CONF_ACTIVATION_FAILED_RUN_AA_REMOVE"
        mv "$A/feeder.conf.pmcp-new" "$A/feeder.conf" || fail "AA_MODE_ACTIVATION_FAILED_RUN_AA_REMOVE"
        mv "$A/AA_BOOT.pmcp-new" "$A/AA_BOOT" || fail "AA_SET_ACTIVATION_FAILED_RUN_AA_REMOVE"
    else
        # off: (an unknown AA state never gets here: the unit state is PARTIAL then)
        NEWA="${ROOT:?}/.aa-new"
        rm -rf "$NEWA" 2>/dev/null
        rm -f "$GAL.pmcp-new" "$GAL.pmcp-restore" 2>/dev/null
        mkdir "$NEWA" || fail "AA_STAGE_CREATE_FAILED"
        say "Staging"
        cp "$GAL" "$NEWA/gal.real" || fail "AA_FACTORY_GAL_COPY_FAILED"
        set -- `manifest_get AA_DMDT_FLUSH`; D_SHA=$1; D_SIZE=$2; D_PATH=$3
        cp "$PAYLOAD/$D_PATH" "$NEWA/libdmdt_flush.so" || fail "COPY_AA_DMDT_FLUSH"
        cp "$PAYLOAD/$K_PATH" "$NEWA/libgal_hook.so" || fail "COPY_AA_HOOK"
        cp "$PAYLOAD/$F_PATH" "$NEWA/aa-most-feeder" || fail "COPY_AA_FEEDER"
        cp "$PAYLOAD/$C_PATH" "$NEWA/gal-hook.conf" || fail "COPY_AA_HOOK_CONF"
        cp "$PAYLOAD/$M_PATH" "$NEWA/feeder.conf" || fail "AA_MODE_COPY_FAILED"
        echo "$SET" > "$NEWA/AA_BOOT" || fail "AA_SET_STAGE_FAILED"
        chmod 755 "$NEWA/gal.real" "$NEWA/aa-most-feeder" || fail "CHMOD_FAILED"
        chmod 644 "$NEWA/libgal_hook.so" "$NEWA/libdmdt_flush.so" "$NEWA/gal-hook.conf" "$NEWA/feeder.conf" || fail "CHMOD_FAILED"
        set -- `manifest_get AA_WRAPPER`; AW_SHA=$1; AW_SIZE=$2; AW_PATH=$3
        cp "$PAYLOAD/$AW_PATH" "$GAL.pmcp-new" && chmod 755 "$GAL.pmcp-new" || fail "AA_WRAPPER_STAGE_FAILED"
        say "Verifying every staged copy"
        check "$NEWA/gal.real" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" STAGED_FACTORY_GAL
        check "$NEWA/libdmdt_flush.so" "$D_SHA" "$D_SIZE" STAGED_AA_DMDT_FLUSH
        check "$NEWA/libgal_hook.so" "$K_SHA" "$K_SIZE" STAGED_AA_HOOK
        check "$NEWA/aa-most-feeder" "$F_SHA" "$F_SIZE" STAGED_AA_FEEDER
        check "$NEWA/gal-hook.conf" "$C_SHA" "$C_SIZE" STAGED_AA_HOOK_CONF
        check "$NEWA/feeder.conf" "$M_SHA" "$M_SIZE" STAGED_AA_MODE
        [ "`cat "$NEWA/AA_BOOT" 2>/dev/null`" = "$SET" ] || fail "AA_SET_STAGE_READBACK_FAILED"
        check "$GAL.pmcp-new" "$AW_SHA" "$AW_SIZE" STAGED_AA_WRAPPER
        [ -x "$GAL.pmcp-new" ] || fail "STAGED_AA_WRAPPER_NOT_EXECUTABLE"
        matches "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" || fail "GAL_CHANGED_DURING_AA_ON"
        say "Activating"
        # the files first, the wrapper last: until gal is replaced nothing of this is used
        mv "$NEWA" "$AADIR" || fail "AA_DIR_ACTIVATION_FAILED"
        mv "$GAL.pmcp-new" "$GAL" || { aa_off; fail "AA_WRAPPER_ACTIVATION_FAILED"; }
    fi
    # a set confirmed before stays confirmed; any other set gets a new trial start
    if [ -e "$PERSIST/aa-ok.$SET" ]; then _o_kept=yes
    else _o_kept=no; rm -f "$PERSIST/aa-trial.$SET" 2>/dev/null; fi
    rm -f "$PERSIST/aa-capture" 2>/dev/null
    # the stable set: the recording (experimental) goes; the output the user chose (AA 1.0: GEM or the settings page) stays,
    # only as a valid line (the feeder's first valid one), so an update by 3 never moves a user from the bridge to direct
    if [ "$ARG" = gamma ]; then
        # the feeder's rule (v14): key at the line start, value exactly direct|ring, trailing blanks/CR ignored, first
        # valid line wins; sed with the same anchors, so 3 keeps exactly what the feeder uses
        _o_out=""
        if [ -f "$PERSIST/aa-extra.conf" ]; then
            for _o_v in `sed -n 's/^PMCP_AA_OUTPUT=\([a-z]*\)[[:space:]]*$/\1/p' "$PERSIST/aa-extra.conf" 2>/dev/null`; do
                case "$_o_v" in direct|ring) _o_out=$_o_v; break ;; esac
            done
        fi
        rm -f "$PERSIST"/aa-extra.conf.pmcp-new "$PERSIST"/aa-stream.h264* 2>/dev/null
        if [ -n "$_o_out" ] && echo "# pmcp $PMCP_VERSION: AA switches (kept by 3)" > "$PERSIST/aa-extra.conf.pmcp-new" 2>/dev/null \
            && echo "PMCP_AA_OUTPUT=$_o_out" >> "$PERSIST/aa-extra.conf.pmcp-new" 2>/dev/null \
            && mv "$PERSIST/aa-extra.conf.pmcp-new" "$PERSIST/aa-extra.conf" && grep -qx "PMCP_AA_OUTPUT=$_o_out" "$PERSIST/aa-extra.conf"; then
            say "  AA output kept: $_o_out"
        else
            [ -e "$PERSIST/aa-extra.conf" ] && say "  AA output: the set's default (direct)"
            rm -f "$PERSIST/aa-extra.conf" "$PERSIST"/aa-extra.conf.pmcp-new 2>/dev/null
        fi
    fi
    detect_state
    if [ "$AASYS" != on ] || [ "$AAMODE" != "$ARG" ]; then
        aa_off
        fail "POST_AA_ON_STATE_${AASYS}_${AAMODE}_ROLLED_BACK"
    fi
    flush
    say "PMCP_AA_ON_OK mode=$ARG set=$SET"
    [ "$ARG" = gammax ] && say "EXPERIMENTAL Android Auto set (aa_advanced). Main menu 3 goes back to the stable set."
    if [ $_o_kept = yes ]; then
        say "This set was confirmed before: it starts with every AA connection, no trial needed."
    else
        say "Connect the Android phone (cable). That first Android Auto session in this start is a TRIAL."
        say "If AA works: open the main menu again and press 5. Confirm, in that same start. Otherwise restart: factory AA."
    fi
    # rg reads the hook's manoeuvres during an Android Auto connection (connection type 3) and gives the VW arrows
    _a_rg=no
    if [ "$STATE" = JAVA ]; then
        case " `current_set` " in *" rg "*) _a_rg=yes ;; esac
    fi
    [ $_a_rg = yes ] || say "VW arrows from Google Maps need rg: main menu, 4. Install additional features."
    return 0
}

# Main menu 3: this card's (stable) Android Auto set. Android Auto files of a version this card does not support (an
# experimental card's set, an interrupted install) are removed first with aa_off (factory gal back, only from a copy
# with the factory hash; nothing is written otherwise), then the stable set is installed. An earlier card's whole set
# (AA_OLD) is brought up to date in place, as aa-on does.
do_aa_install() {    # [gammax]: aa-on-exp, the experimental set of an experimental card (aa_advanced)
    _n_t=${1:-gamma}
    [ $_n_t = gamma ] || [ -n "`manifest_get AAX_FEEDER`" ] || fail "AA_EXPERIMENTAL_NOT_ON_THIS_CARD"
    selftest
    firmware_identity
    detect_state
    if [ "$AASYS" = on ] && [ "$AAMODE" = $_n_t ]; then
        say "PMCP_AA_INSTALL_OK (already installed: this card's Android Auto set `aa_set_id $_n_t`, nothing changed)"
        return 0
    fi
    if [ "$AASYS" = on ]; then
        [ $_n_t = gamma ] && say "Experimental Android Auto set on the unit: replacing it with this card's stable set"
        [ $_n_t = gammax ] && say "Stable Android Auto set on the unit: replacing it with this card's experimental set"
    fi
    case "$CORE_STATE" in
        VIDEO|JAVA) ;;
        STOCK) fail "AA_INSTALL_NEEDS_CARPLAY_FIRST_PRESS_2" ;;
        PARTIAL) if java_part_tolerable; then
               say "Java part of a version this card does not support: left as it is (Android Auto does not touch it; 4 replaces it)"
           else
               [ -n "$STATE_WHY" ] && say "  $STATE_WHY"
               [ "$MAPOK" = yes ] && fail "AA_INSTALL_NEEDS_THE_FEATURES_REPAIRED_FIRST_PRESS_4_THEN_3"
               fail "AA_INSTALL_NEEDS_A_WORKING_CARPLAY_INSTALL_PRESS_2_STATE_$STATE"
           fi ;;
        *) [ -n "$STATE_WHY" ] && say "  $STATE_WHY"
           [ "$MAPOK" = yes ] && fail "AA_INSTALL_NEEDS_THE_FEATURES_REPAIRED_FIRST_PRESS_4_THEN_3"
           fail "AA_INSTALL_NEEDS_A_WORKING_CARPLAY_INSTALL_PRESS_2_STATE_$STATE" ;;
    esac
    # this card's AA files first: nothing is removed for a set that could not be installed
    aa_check_payload $_n_t
    if [ "$AASYS" = unknown ]; then
        say "Android Auto files of a version this card does not support: removing them first (factory gal back)"
        aa_off
        flush
        detect_state
        [ "$AASYS" = off ] || fail "AA_INSTALL_REMOVE_LEFT_AA_$AASYS"
        say "  removed; installing this card's Android Auto"
    fi
    ARG=$_n_t
    do_aa_on
}

# ---- main menu 5 and 6: one Confirm / Try again for both trials -----------------------------------------------------
# The Java set (CarPlay features: trial = the first unit start with a new set) and the Android Auto set (trial = the
# first AA connection with a new set) have separate trials. 5. Confirm confirms whichever of them is in its trial now
# and says why the other one is not confirmed; it fails only when nothing was confirmed.
java_confirm_try() {
    _k_set=`boot_set_id`
    if [ -e "$PERSIST/DISABLED" ]; then say "  CarPlay features: switched off by the rescue card (6. Try again, then restart)"; return 1; fi
    if [ -e "$PERSIST/ok.$_k_set" ]; then say "  CarPlay features (set $_k_set): already confirmed"; return 1; fi
    if [ ! -e "$PERSIST/trial.$_k_set" ]; then say "  CarPlay features: no trial start yet (restart the unit first)"; return 1; fi
    if [ "`cat "$PERSIST/last-boot" 2>/dev/null`" != "set=$_k_set use=trial" ]; then
        say "  CarPlay features: this is not their trial start (6. Try again, then restart)"; return 1
    fi
    touch "$PERSIST/ok.$_k_set" && [ -e "$PERSIST/ok.$_k_set" ] || fail "CONFIRM_MARKER_FAILED"
    echo "gem-ok set=$_k_set" >> "$PERSIST/boot.log" 2>/dev/null
    say "PMCP_JAVA_CONFIRM_OK set=$_k_set (this set now loads on every boot)"
}

aa_confirm_try() {
    _k_aa=`aa_set_id $AAMODE`
    if [ -e "$PERSIST/DISABLED" ]; then say "  Android Auto: switched off by the rescue card (6. Try again, then restart)"; return 1; fi
    if [ -e "$PERSIST/aa-ok.$_k_aa" ]; then say "  Android Auto (set $_k_aa): already confirmed"; return 1; fi
    if [ ! -e "$PERSIST/aa-trial.$_k_aa" ]; then say "  Android Auto: no trial yet (connect the phone first, then 5 again)"; return 1; fi
    if [ ! -e "$RAMDISK/pmcp-aa-trial.$_k_aa" ]; then
        say "  Android Auto: this is not its trial start (6. Try again, then restart)"; return 1
    fi
    rm -f "$PERSIST"/aa-ok.* 2>/dev/null
    touch "$PERSIST/aa-ok.$_k_aa" && [ -e "$PERSIST/aa-ok.$_k_aa" ] || fail "AA_CONFIRM_MARKER_FAILED"
    say "PMCP_AA_CONFIRM_OK set=$_k_aa (Android Auto now starts with this set every time)"
}

do_confirm() {
    selftest
    firmware_identity
    detect_state
    _k_n=0; _k_any=no
    if [ "$CORE_STATE" = JAVA ]; then _k_any=yes; java_confirm_try && _k_n=$((_k_n + 1)); fi
    if [ "$AASYS" = on ]; then _k_any=yes; aa_confirm_try && _k_n=$((_k_n + 1)); fi
    [ $_k_any = yes ] || fail "CONFIRM_NOTHING_INSTALLED_THAT_HAS_A_TRIAL_STATE_$STATE"
    [ $_k_n -gt 0 ] || fail "CONFIRM_NOTHING_IN_ITS_TRIAL_NOW"
    flush
    say "PMCP_CONFIRM_OK confirmed=$_k_n"
}

do_retry() {
    selftest
    firmware_identity
    detect_state
    _t_n=0; _t_any=no
    # after the rescue card (DISABLED, shared by both parts) every set gets a new trial, also a confirmed one: the rescue
    # card was used because something did not work, so nothing comes back without a trial
    _t_dis=no; [ -e "$PERSIST/DISABLED" ] && _t_dis=yes
    if [ "$CORE_STATE" = JAVA ]; then
        _t_any=yes; _t_set=`boot_set_id`
        if [ -e "$PERSIST/ok.$_t_set" ] && [ $_t_dis = no ]; then
            say "  CarPlay features (set $_t_set): confirmed, nothing to try again"
        else
            rm -f "$PERSIST/trial.$_t_set" "$PERSIST/ok.$_t_set" || fail "RETRY_MARKER_REMOVE_FAILED"
            say "PMCP_JAVA_RETRY_OK set=$_t_set (the next boot is a new trial)"; _t_n=$((_t_n + 1))
        fi
    fi
    if [ "$AASYS" = on ]; then
        _t_any=yes; _t_aa=`aa_set_id $AAMODE`
        if [ -e "$PERSIST/aa-ok.$_t_aa" ] && [ $_t_dis = no ]; then
            say "  Android Auto (set $_t_aa): confirmed, nothing to try again"
        else
            rm -f "$PERSIST/aa-trial.$_t_aa" "$PERSIST/aa-ok.$_t_aa" || fail "AA_RETRY_MARKER_REMOVE_FAILED"
            say "PMCP_AA_RETRY_OK set=$_t_aa (the next AA connection after a restart is a new trial)"; _t_n=$((_t_n + 1))
        fi
    fi
    [ $_t_any = yes ] || fail "RETRY_NOTHING_INSTALLED_THAT_HAS_A_TRIAL_STATE_$STATE"
    [ $_t_n -gt 0 ] || fail "RETRY_EVERYTHING_ALREADY_CONFIRMED"
    if [ $_t_dis = yes ]; then
        rm -f "$PERSIST/DISABLED" || fail "RETRY_MARKER_REMOVE_FAILED"
        say "  rescue card switch-off removed: everything starts with a new trial"
    fi
    flush
    say "PMCP_RETRY_OK (restart the unit: hold the volume knob ~10 s)"
}

do_aa_confirm() {
    selftest
    firmware_identity
    detect_state
    [ "$AASYS" = on ] || fail "AA_CONFIRM_NEEDS_AA_ON_$AASYS"
    SET=`aa_set_id $AAMODE`
    [ ! -e "$PERSIST/DISABLED" ] || fail "AA_DISABLED_BY_RESCUE_CARD"
    [ -e "$PERSIST/aa-ok.$SET" ] && fail "AA_ALREADY_CONFIRMED_$SET"
    [ -e "$PERSIST/aa-trial.$SET" ] || fail "AA_NO_TRIAL_YET_CONNECT_THE_PHONE_FIRST"
    [ -e "$RAMDISK/pmcp-aa-trial.$SET" ] || fail "AA_NOT_IN_THE_TRIAL_START_USE_aa-retry_AND_RESTART"
    rm -f "$PERSIST"/aa-ok.* 2>/dev/null
    touch "$PERSIST/aa-ok.$SET" || fail "AA_CONFIRM_MARKER_FAILED"
    [ -e "$PERSIST/aa-ok.$SET" ] || fail "AA_CONFIRM_MARKER_FAILED"
    flush
    say "PMCP_AA_CONFIRM_OK set=$SET (Android Auto now starts with this set every time)"
}

do_aa_retry() {
    selftest
    firmware_identity
    detect_state
    [ "$AASYS" = on ] || fail "AA_RETRY_NEEDS_AA_ON_$AASYS"
    SET=`aa_set_id $AAMODE`
    rm -f "$PERSIST/aa-trial.$SET" || fail "AA_RETRY_MARKER_REMOVE_FAILED"
    flush
    say "PMCP_AA_RETRY_OK set=$SET (restart the unit; the next AA connection is a new trial)"
}

# AA switches, read by the feeder (v12+) at each AA connection from /mnt/persist/pmcp/aa-extra.conf: only PMCP_AA_OUTPUT
# (direct|ring; any other value is ignored by feeder v14, so the set's default applies) and PMCP_AA_CAPTURE_S are taken
# from it. One key changes, the other is kept; the file is replaced in one mv. Main menu 3 removes the file.
aa_extra_set() {    # KEY VALUE
    _x_f="$PERSIST/aa-extra.conf"
    # the other key is kept only as a valid line (output: direct|ring; recording: 0|60), as the feeder reads it
    _x_out=`grep -x -e 'PMCP_AA_OUTPUT=direct' -e 'PMCP_AA_OUTPUT=ring' "$_x_f" 2>/dev/null | head -1`
    _x_cap=`grep -x -e 'PMCP_AA_CAPTURE_S=0' -e 'PMCP_AA_CAPTURE_S=60' "$_x_f" 2>/dev/null | head -1`
    case "$1" in
        PMCP_AA_OUTPUT) _x_out="PMCP_AA_OUTPUT=$2" ;;
        PMCP_AA_CAPTURE_S) _x_cap="PMCP_AA_CAPTURE_S=$2" ;;
    esac
    mkdir -p "$PERSIST" 2>/dev/null
    rm -f "$_x_f.pmcp-new" 2>/dev/null
    # redirects on echo only (a failed redirect on a compound command may end the script without a FAIL line)
    echo "# pmcp $PMCP_VERSION: AA switches (GEM)" > "$_x_f.pmcp-new" 2>/dev/null || fail "AA_SWITCH_WRITE_FAILED"
    if [ -n "$_x_out" ]; then echo "$_x_out" >> "$_x_f.pmcp-new" 2>/dev/null || fail "AA_SWITCH_WRITE_FAILED"; fi
    if [ -n "$_x_cap" ]; then echo "$_x_cap" >> "$_x_f.pmcp-new" 2>/dev/null || fail "AA_SWITCH_WRITE_FAILED"; fi
    mv "$_x_f.pmcp-new" "$_x_f" || fail "AA_SWITCH_WRITE_FAILED"
    grep -qx "$1=$2" "$_x_f" || fail "AA_SWITCH_READBACK_FAILED"
}

aa_switch_ready() {    # [exp]: experimental cards only (aa-capture)
    if [ "$1" = exp ]; then
        case "$PMCP_VERSION" in *-exp-*) ;; *) fail "AA_EXPERIMENTAL_NOT_ON_THIS_CARD" ;; esac
    fi
    selftest
    firmware_identity
    detect_state
    [ "$AASYS" = on ] || fail "AA_SWITCH_NEEDS_THIS_CARDS_AA_SET_ON_$AASYS${AAMODE:+_$AAMODE}"
}

do_aa_output() {
    aa_switch_ready
    case "$ARG" in
        direct|ring) ;;
        *) fail "AA_OUTPUT_MUST_BE_direct_OR_ring" ;;
    esac
    # AA 1.0 (user decision A153): no trial. The output changes no file of the set, no AA_BOOT and no marker (the same
    # hook and feeder take the phone); a direct output that cannot take MOST gives it back and the AID keeps the VW map.
    aa_extra_set PMCP_AA_OUTPUT "$ARG"
    flush
    say "PMCP_AA_OUTPUT_OK output=$ARG (from the next AA connection; unplug and plug the phone)"
}

# Recording (PMCP_AA_CAPTURE_S in aa-extra.conf): the feeder writes the phone's video to aa-stream.h264, the picture is
# the same, so the confirmation stays. Not the gal wrapper's /mnt/persist/pmcp/aa-capture (the 1.7 navigation capture
# of earlier cards; its comment still says "pmcp.sh aa-capture"): pmcp.sh removes that marker and never writes it.
do_aa_capture() {
    aa_switch_ready exp
    case "$ARG" in
        60) aa_extra_set PMCP_AA_CAPTURE_S 60 ;;
        off) aa_extra_set PMCP_AA_CAPTURE_S 0 ;;
        *) fail "AA_CAPTURE_MUST_BE_60_OR_off" ;;
    esac
    flush
    say "PMCP_AA_CAPTURE_OK capture=$ARG (each AA connection overwrites /mnt/persist/pmcp/aa-stream.h264; the log card copies it)"
}

# AA log: the hook log and feeder summary live in /ramdisk and are gone at the next start; in GEM the SD card is
# read-only, so they go to carplaymaps/logs, and the log card (update mode) copies them to its SD card.
AA_LOG_MAX=5
do_aa_log_save() {
    selftest
    firmware_identity
    detect_state
    case "$STATE" in VIDEO|JAVA|PARTIAL) ;; *) fail "AA_LOG_NEEDS_PMCP_STATE_$STATE" ;; esac
    [ -s "$RAMDISK/pmcp-gal-hook.log" ] || fail "AA_LOG_EMPTY_CONNECT_THE_PHONE_FIRST"
    _l_n=1
    while [ -e "$ROOT/logs/aa-log-$_l_n.txt" ]; do
        _l_n=$((_l_n + 1))
        [ $_l_n -le $AA_LOG_MAX ] || fail "AA_LOGS_FULL_${AA_LOG_MAX}_USE_THE_LOG_CARD_THEN_AA_DELETE_LOGS"
    done
    remount_rw
    mkdir -p "$ROOT/logs" || fail "AA_LOG_DIR_FAILED"
    _l_f="$ROOT/logs/aa-log-$_l_n.txt"
    rm -f "$_l_f.pmcp-new" 2>/dev/null
    if ! { echo "pmcp $PMCP_VERSION aa-log-save `date 2>/dev/null`"
           echo "--- pmcp-aa-last"; cat "$RAMDISK/pmcp-aa-last" 2>/dev/null
           echo "--- pmcp-aa-feeder.txt"; cat "$RAMDISK/pmcp-aa-feeder.txt" 2>/dev/null
           for _l_p in 1 2 3; do       # feeder v13: full status of the earlier sessions of this start
               [ -s "$RAMDISK/pmcp-aa-feeder.txt-prev$_l_p" ] || continue
               echo "--- pmcp-aa-feeder.txt-prev$_l_p"; cat "$RAMDISK/pmcp-aa-feeder.txt-prev$_l_p" 2>/dev/null
           done
           echo "--- pmcp-gal-hook.log"; cat "$RAMDISK/pmcp-gal-hook.log"
           # A166: route guidance from AA, the raw navigation messages and which view the AID showed
           for _l_x in pmcp-aa-rg.txt pmcp-aa-rg-raw.txt.1 pmcp-aa-rg-raw.txt pmcp-kombi-view.log.1 pmcp-kombi-view.log; do
               [ -s "$RAMDISK/$_l_x" ] || continue
               echo "--- $_l_x"; cat "$RAMDISK/$_l_x" 2>/dev/null
           done
           echo "--- end"; } > "$_l_f.pmcp-new" 2>/dev/null; then
        rm -f "$_l_f.pmcp-new" 2>/dev/null
        fail "AA_LOG_WRITE_FAILED"
    fi
    _l_have=`size_of "$_l_f.pmcp-new"`; _l_src=`size_of "$RAMDISK/pmcp-gal-hook.log"`
    [ -n "$_l_have" ] && [ -n "$_l_src" ] && [ "$_l_have" -gt "$_l_src" ] || { rm -f "$_l_f.pmcp-new"; fail "AA_LOG_COPY_SHORT"; }
    mv "$_l_f.pmcp-new" "$_l_f" || fail "AA_LOG_RENAME_FAILED"
    flush
    aa_nav_counts
    say "PMCP_AA_LOG_SAVED file=logs/aa-log-$_l_n.txt bytes=$_l_have nav_0x8006=$_c_6 nav_0x8007=$_c_7"
    say "To the computer: log card (card 3) in update mode. Up to $AA_LOG_MAX logs are kept; AA delete logs empties them."
}

# Everything pmcp saves for the log card: the whole logs/ directory (AA and CarPlay logs, temp files, anything else in
# it), the recorded phone video, the GEM button log (gem.log emptied: this press is its first entry) and pmcp's boot log (lsd.sh appends a line each start, so it is never needed back).
# Nothing to delete is not an error (A152: a second press showed a FAIL).
do_aa_log_clear() {
    selftest
    firmware_identity
    detect_state
    # carplaymaps/logs only when carplaymaps is ours (review A153: never another mod's directory)
    if [ -e "$ROOT/logs" ] && ! pmcp_root; then
        fail "AA_LOG_CLEAR_CARPLAYMAPS_IS_NOT_A_PMCP_INSTALL_NOTHING_CHANGED"
    fi
    _c_any=""
    for _c_f in "$ROOT/logs" "$PERSIST"/aa-stream.h264* "$PERSIST/boot.log" "$PERSIST/gem.log.1"; do [ -e "$_c_f" ] && _c_any=1; done
    if [ -z "$_c_any" ]; then
        aa_gemlog_restart
        say "PMCP_AA_LOG_CLEAR_OK (nothing saved, nothing to delete)"
        return 0
    fi
    remount_rw
    rm -rf "${ROOT:?}/logs" 2>/dev/null
    rm -f "$PERSIST"/aa-stream.h264* "$PERSIST/boot.log" "$PERSIST/gem.log.1" 2>/dev/null
    for _c_f in "$ROOT/logs" "$PERSIST"/aa-stream.h264* "$PERSIST/boot.log" "$PERSIST/gem.log.1"; do
        [ -e "$_c_f" ] && fail "AA_LOG_CLEAR_FAILED_${_c_f##*/}"
    done
    aa_gemlog_restart   # only after the deletes: a failure above keeps the button history that explains it
    flush
    say "PMCP_AA_LOG_CLEAR_OK"
}

# gem.log starts again with this press (its header written again). Redirects on echo only: a failed redirect on the
# special builtin ":" would end the script (review A153).
aa_gemlog_restart() {
    [ -n "$GEMLOG" ] || return 0
    { echo "=== $PMCP_VERSION $ACTION $ARG `date 2>/dev/null`" > "$GEMLOG"; } 2>/dev/null || GEMLOG=""
    say "pmcp $PMCP_VERSION: $ACTION $ARG (gem.log emptied)"
}

# navigation messages the hook logged in this start (event=aap.nav_msg)
aa_nav_counts() {
    _c_6=0; _c_7=0
    [ -s "$RAMDISK/pmcp-gal-hook.log" ] || return 0
    while read l; do
        case "$l" in
            *event=aap.nav_msg*msg_id=0x8006*) _c_6=$((_c_6 + 1)) ;;
            *event=aap.nav_msg*msg_id=0x8007*) _c_7=$((_c_7 + 1)) ;;
        esac
    done < "$RAMDISK/pmcp-gal-hook.log"
}

do_aa_status() {
    firmware_identity
    detect_state
    say "Unit state: $STATE"
    say "Android Auto: $AASYS${AAMODE:+ mode=$AAMODE}"
    [ "$AASYS" = old ] && say "  AA files from an earlier card (mode $AAMODE): Android Auto on brings them up to date (no AA remove needed)"
    if [ "$AASYS" = on ]; then
        SET=`aa_set_id $AAMODE`
        if [ -e "$PERSIST/aa-ok.$SET" ]; then say "  set $SET: confirmed"
        elif [ -e "$RAMDISK/pmcp-aa-trial.$SET" ]; then say "  set $SET: TRIAL in this start (Confirm AA if it works)"
        elif [ -e "$PERSIST/aa-trial.$SET" ]; then say "  set $SET: trial used, not confirmed (factory AA now; Try again)"
        else say "  set $SET: waiting for the first AA connection (trial)"; fi
    fi
    [ "$AAMODE" = gammax ] && say "  EXPERIMENTAL set (aa_advanced); main menu 3 goes back to the stable set"
    [ -s "$RAMDISK/pmcp-aa-last" ] && say "Last gal start: `cat "$RAMDISK/pmcp-aa-last"`"
    # one line from awk (gawk on the unit; no tr there: "tr: cannot execute", seen on the unit 2026-11-11), outside
    # double quotes: ksh misparses double quotes in a backtick command inside a double-quoted string
    if [ -s "$PERSIST/aa-extra.conf" ]; then
        _s_x=`awk '/^PMCP_AA_/ { printf "%s ", $0 }' "$PERSIST/aa-extra.conf" 2>/dev/null`
        say "AA switches: $_s_x"
    fi
    [ -s "$PERSIST/aa-stream.h264" ] && say "Recorded phone video: `ls -l "$PERSIST/aa-stream.h264" 2>/dev/null | awk '{print $5}'` bytes"
    aa_nav_counts
    say "Navigation messages logged in this start: 0x8006=$_c_6 0x8007=$_c_7"
    # gamma: the hook's manoeuvre feed for rg (counts, recognised / unknown types, the last manoeuvres)
    if [ -s "$RAMDISK/pmcp-aa-rg.txt" ]; then
        say "Manoeuvres for rg (gamma, /ramdisk/pmcp-aa-rg):"
        while read l; do say "  $l"; done < "$RAMDISK/pmcp-aa-rg.txt"
    fi
    if [ -d "$ROOT/logs" ]; then
        _s_l=""; for _s_f in "$ROOT"/logs/*; do [ -f "$_s_f" ] && _s_l="$_s_l ${_s_f##*/}"; done   # QNX ls lists . and .. (A153)
        say "Saved AA logs (for the log card):${_s_l:- none}"
    fi
    # /ramdisk is 20 MB with the 16 MB video ring on it: show how much is left (the hook log stays under 128 KB)
    if [ -z "${PMCP_TEST_ROOT:-}" ] && type df >/dev/null 2>&1; then
        df -k "$RAMDISK" 2>/dev/null | while read l; do say "  ramdisk: $l"; done
    fi
    if [ -s "$RAMDISK/pmcp-aa-feeder.txt" ]; then
        say "Stream analysis (last AA session):"
        while read l; do say "  $l"; done < "$RAMDISK/pmcp-aa-feeder.txt"
    else
        say "No stream analysis yet (connect the phone and start a route in Google Maps)."
    fi
    if [ -s "$RAMDISK/pmcp-gal-hook.log" ]; then
        _t_n=0
        while read l; do
            case "$l" in
                *firmware.verify*|*firmware.trial*|*result=failed*|*player.spawn*)
                    _t_n=$((_t_n + 1)); [ $_t_n -le 12 ] && say "  hook: $l" ;;
            esac
        done < "$RAMDISK/pmcp-gal-hook.log"
    fi
    say "PMCP_AA_STATUS_OK"
}

# RGSYS -> off (factory driver + cfg, no SYSTEM_ON) | on (our driver, cfg, reader, SYSTEM_ON, factory copies kept)
#        | old (as on, but the driver and/or the reader is an earlier card's, RG_KNOWN: rg-update) | unknown
# DRV_NEW / RD_NEW (on and old): yes when rg-update has to replace the driver / the reader
rg_state() {
    set -- `manifest_get RG_DRIVER`; RD_SHA=$1; RD_SIZE=$2
    set -- `manifest_get RG_CFG`; RC_SHA=$1; RC_SIZE=$2
    set -- `manifest_get RG_READER`; RR_SHA=$1; RR_SIZE=$2
    RGSYS=unknown; DRV_NEW=no; RD_NEW=no
    if [ ! -e "$RGDIR/SYSTEM_ON" ] && matches "$DRV" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" && matches "$CFG" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE"; then
        RGSYS=off
    elif [ -e "$RGDIR/SYSTEM_ON" ] && matches "$CFG" "$RC_SHA" "$RC_SIZE" \
        && matches "$ROOT/rollback/ipod-drvr-iap2.so" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" \
        && matches "$ROOT/rollback/iap2.cfg" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE"; then
        if matches "$DRV" "$RD_SHA" "$RD_SIZE"; then :
        elif rg_known DRIVER "$DRV"; then DRV_NEW=yes
        else return 0; fi
        if matches "$RGDIR/rgi-observer" "$RR_SHA" "$RR_SIZE"; then :
        elif rg_known READER "$RGDIR/rgi-observer"; then RD_NEW=yes
        else return 0; fi
        if [ $DRV_NEW = no ] && [ $RD_NEW = no ]; then RGSYS=on; else RGSYS=old; fi
    fi
    return 0
}

# rg_known KIND FILE -> 0 when FILE is one of the earlier pmcp files of KIND (DRIVER or READER) listed in RG_KNOWN
rg_known() {
    _n_hit=1
    while read _n_k _n_h _n_s; do
        [ "$_n_k" = "$1" ] || continue
        matches "$2" "$_n_h" "$_n_s" && { _n_hit=0; break; }
    done <<EOF
$RG_KNOWN
EOF
    return $_n_hit
}

remount_sys() {
    if [ -n "${PMCP_TEST_ROOT:-}" ]; then
        :
    elif [ -n "$MMX" ]; then
        on -f mmx mount -uw /mnt/system >/dev/null 2>&1 || fail "SYSTEM_REMOUNT_FAILED"
    else
        mount -uw /mnt/system >/dev/null 2>&1 || fail "SYSTEM_REMOUNT_FAILED"
    fi
}

stop_reader() {
    [ -n "${PMCP_TEST_ROOT:-}" ] && return
    if [ -n "$MMX" ]; then on -f mmx slay -f rgi-observer >/dev/null 2>&1 || true
    else slay -f rgi-observer >/dev/null 2>&1 || true; fi
}

remount_rw() {
    if [ -n "${PMCP_TEST_ROOT:-}" ]; then
        :
    elif [ -n "$MMX" ]; then
        on -f mmx mount -uw /mnt/app >/dev/null 2>&1 || fail "APP_REMOUNT_FAILED"
    else
        mount -uw /mnt/app >/dev/null 2>&1 || fail "APP_REMOUNT_FAILED"
    fi
}

stop_runtime() {
    [ -n "${PMCP_TEST_ROOT:-}" ] && return
    for p in carplay-cluster-supervisor altscreen-most-bridge carplay-pairing-helper; do
        if [ -n "$MMX" ]; then
            on -f mmx slay -f "$p" >/dev/null 2>&1 || true
        else
            slay -f "$p" >/dev/null 2>&1 || true
        fi
    done
}

# variant name -> manifest key, only for names made of [a-z0-9-] that the manifest knows
variant_key() {
    case "$1" in ""|*[!a-z0-9-]*) return ;; esac
    [ -n "`manifest_get "CORE_$1"`" ] && echo "CORE_$1"
}

# ---------------------------------------------------------------- actions
# carplaymaps away in one mv first, then deleted: an interruption leaves either a complete install or a
# .carplaymaps-old-* leftover that install/restore delete, never a half-deleted install the tool cannot read.
remove_root() {
    _r_old="$APP/.carplaymaps-old-$$"
    mv "$ROOT" "$_r_old" || return 1
    flush
    rm -rf "$_r_old"
}

remove_stale() {
    for _x_d in "$APP"/.carplaymaps-new-* "$APP"/.carplaymaps-old-*; do
        [ -d "$_x_d" ] && { say "  removing leftover $_x_d"; rm -rf "$_x_d"; }
    done
}

rollback_install() {
    say "Rolling back"
    cp "$ROOT/stock_first/dio_manager.real" "$DIO.pmcp-rb" 2>/dev/null && chmod 755 "$DIO.pmcp-rb" && mv "$DIO.pmcp-rb" "$DIO"
    rm -f "$DIO.pmcp-new" 2>/dev/null
    if matches "$DIO" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" && [ -x "$DIO" ] && matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE"; then
        remove_root
        say "PMCP_ROLLBACK_OK (factory files verified)"
    else
        say "PMCP_ROLLBACK_INCOMPLETE: factory copies are kept in /mnt/app/carplaymaps; run restore"
    fi
}

do_verify() {
    selftest
    verify_payload
    firmware_identity
    detect_state
    say "Unit state: $STATE"
    [ -n "$STATE_WHY" ] && say "  $STATE_WHY"
    if [ "$STATE" = VIDEO ] || [ "$STATE" = JAVA ]; then
        say "Installed: `cat "$ROOT/PMCP_VERSION"` variant `cat "$ROOT/VARIANT" 2>/dev/null`"
    fi
    say "PMCP_VERIFY_OK state=$STATE"
}

do_install() {
    key=`variant_key "$ARG"`
    [ -n "$key" ] || fail "UNKNOWN_VARIANT_$ARG"
    selftest
    verify_payload
    firmware_identity
    detect_state
    [ "$STATE" = STOCK ] || fail "UNIT_NOT_FACTORY_STATE_$STATE"
    say "Unit is in factory state; installing variant $ARG"

    set -- `manifest_get "$key"`;         C_SHA=$1; C_SIZE=$2; C_PATH=$3
    set -- `manifest_get WRAPPER`;        W_SHA=$1; W_SIZE=$2; W_PATH=$3

    remount_rw
    # Leftovers of an interrupted earlier attempt (never active files: those are covered by detect_state).
    remove_stale
    rm -f "$DIO.pmcp-new" "$LSD.pmcp-new" "$DIO.pmcp-rb" "$LSD.pmcp-rb" "$DIO.pmcp-restore" "$LSD.pmcp-restore" 2>/dev/null
    # Old trial/ok markers must not carry over to a new install (they are per JAR hash, a set could skip its trial).
    rm -rf "$PERSIST" 2>/dev/null
    [ ! -e "$PERSIST" ] || fail "OLD_TRIAL_MARKERS_NOT_REMOVED"
    NEW="$APP/.carplaymaps-new-$$"
    mkdir -p "$NEW/stock_first" "$NEW/rollback" "$NEW/security_bridge" "$NEW/tools" || fail "STAGE_CREATE_FAILED"

    say "Staging"
    cp "$DIO" "$NEW/stock_first/dio_manager.real" || fail "STOCK_DIO_COPY_FAILED"
    cp "$LSD" "$NEW/rollback/lsd.sh" || fail "STOCK_LSD_COPY_FAILED"
    cp "$PAYLOAD/$C_PATH" "$NEW/core.so" || fail "CORE_COPY_FAILED"
    while read k h s p; do
        case "$k" in
            BRIDGE)       cp "$PAYLOAD/$p" "$NEW/altscreen-most-bridge" || fail "COPY_$k" ;;
            SUPERVISOR)   cp "$PAYLOAD/$p" "$NEW/carplay-cluster-supervisor" || fail "COPY_$k" ;;
            SEC)          cp "$PAYLOAD/$p" "$NEW/libcarplay-security-bridge.so" || fail "COPY_$k" ;;
            PAIR_HELPER)  cp "$PAYLOAD/$p" "$NEW/security_bridge/carplay-pairing-helper" || fail "COPY_$k" ;;
            PAIR_CORE)    cp "$PAYLOAD/$p" "$NEW/security_bridge/libCarPlayPairingCore.so" || fail "COPY_$k" ;;
            WRAPPER)      cp "$PAYLOAD/$p" "$NEW/dio_manager.wrapper.sh" || fail "COPY_$k" ;;
        esac
    done <<EOF
$MANIFEST
EOF
    cp "$0" "$NEW/tools/pmcp.sh" && cp "$SD/bin/sha256.awk" "$NEW/tools/sha256.awk" || fail "TOOLS_COPY_FAILED"
    echo "$PMCP_VERSION" > "$NEW/PMCP_VERSION"
    echo "$ARG" > "$NEW/VARIANT"
    echo "MU1161/791" > "$NEW/PROFILE"
    echo "$PMCP_VERSION" > "$NEW/VERSION"
    touch "$NEW/CLUSTER_AUTO_ENABLE" || fail "MARKER_FAILED"
    chmod 755 "$NEW/dio_manager.wrapper.sh" "$NEW/altscreen-most-bridge" "$NEW/carplay-cluster-supervisor" \
        "$NEW/security_bridge/carplay-pairing-helper" "$NEW/stock_first/dio_manager.real" || fail "CHMOD_FAILED"
    chmod 644 "$NEW/core.so" "$NEW/libcarplay-security-bridge.so" "$NEW/security_bridge/libCarPlayPairingCore.so" \
        "$NEW/rollback/lsd.sh" || fail "CHMOD_FAILED"

    cp "$PAYLOAD/$W_PATH" "$DIO.pmcp-new" || fail "DIO_STAGE_FAILED"
    chmod 755 "$DIO.pmcp-new" || fail "CHMOD_FAILED"
    [ -x "$DIO.pmcp-new" ] || fail "STAGED_DIO_NOT_EXECUTABLE"

    say "Verifying every staged copy"
    check "$NEW/stock_first/dio_manager.real" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" STAGED_STOCK_DIO
    check "$NEW/rollback/lsd.sh" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" STAGED_STOCK_LSD
    check "$NEW/core.so" "$C_SHA" "$C_SIZE" STAGED_CORE
    while read k h s p; do
        case "$k" in
            BRIDGE)      check "$NEW/altscreen-most-bridge" "$h" "$s" STAGED_$k ;;
            SUPERVISOR)  check "$NEW/carplay-cluster-supervisor" "$h" "$s" STAGED_$k ;;
            SEC)         check "$NEW/libcarplay-security-bridge.so" "$h" "$s" STAGED_$k ;;
            PAIR_HELPER) check "$NEW/security_bridge/carplay-pairing-helper" "$h" "$s" STAGED_$k ;;
            PAIR_CORE)   check "$NEW/security_bridge/libCarPlayPairingCore.so" "$h" "$s" STAGED_$k ;;
            WRAPPER)     check "$NEW/dio_manager.wrapper.sh" "$h" "$s" STAGED_$k ;;
        esac
    done <<EOF
$MANIFEST
EOF
    check "$DIO.pmcp-new" "$W_SHA" "$W_SIZE" STAGED_WRAPPER_DIO

    # Re-check the live factory files right before the switch (nothing else may have changed them).
    matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" || fail "LSD_CHANGED_DURING_INSTALL"
    matches "$DIO" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" || fail "DIO_CHANGED_DURING_INSTALL"

    say "Activating"
    mv "$NEW" "$ROOT" || fail "ROOT_ACTIVATION_FAILED"
    mv "$DIO.pmcp-new" "$DIO" || { rollback_install; fail "DIO_ACTIVATION_FAILED"; }

    say "Verifying active files"
    detect_state
    [ "$STATE" = VIDEO ] || { rollback_install; fail "POST_INSTALL_STATE_$STATE"; }
    [ -x "$DIO" ] || { rollback_install; fail "POST_INSTALL_DIO_NOT_EXECUTABLE"; }
    matches "$ROOT/core.so" "$C_SHA" "$C_SIZE" || { rollback_install; fail "POST_INSTALL_CORE"; }
    flush
    say "PMCP_INSTALL_OK stage=A variant=$ARG version=$PMCP_VERSION"
    say "A full unit reboot is required. lsd.sh and the HMI are unchanged."
}

do_switch() {
    key=`variant_key "$ARG"`
    [ -n "$key" ] || fail "UNKNOWN_VARIANT_$ARG"
    selftest
    firmware_identity
    detect_state
    # only core.so changes: the map part has to be ours and intact (route guidance, Java or AA files may be mixed)
    [ "$MAPOK" = yes ] || fail "SWITCH_NEEDS_PMCP_INSTALL_STATE_$STATE"
    set -- `manifest_get "$key"`; C_SHA=$1; C_SIZE=$2; C_PATH=$3
    check "$PAYLOAD/$C_PATH" "$C_SHA" "$C_SIZE" "$key"
    # same map already active: nothing to do (main menu 2 answers "already installed" itself)
    if [ "`cat "$ROOT/VARIANT" 2>/dev/null`" = "$ARG" ] && matches "$ROOT/core.so" "$C_SHA" "$C_SIZE"; then
        fail "SWITCH_ALREADY_$ARG"
    fi
    remount_rw
    stop_runtime
    cp "$PAYLOAD/$C_PATH" "$ROOT/core.so.pmcp-new" || fail "CORE_STAGE_FAILED"
    chmod 644 "$ROOT/core.so.pmcp-new" || fail "CHMOD_FAILED"
    check "$ROOT/core.so.pmcp-new" "$C_SHA" "$C_SIZE" STAGED_CORE
    mv "$ROOT/core.so.pmcp-new" "$ROOT/core.so" || fail "CORE_ACTIVATION_FAILED"
    echo "$ARG" > "$ROOT/VARIANT"
    matches "$ROOT/core.so" "$C_SHA" "$C_SIZE" || fail "POST_SWITCH_CORE"
    flush
    say "PMCP_SWITCH_OK variant=$ARG"
    say "A full unit reboot is required."
}

# the map files in carplaymaps are this card's (core.so is the layout: switch replaces it)
map_files_ok() {
    while read _y_k _y_h _y_s _y_p; do
        case "$_y_k" in
            BRIDGE) _y_f=altscreen-most-bridge ;;
            SUPERVISOR) _y_f=carplay-cluster-supervisor ;;
            SEC) _y_f=libcarplay-security-bridge.so ;;
            PAIR_HELPER) _y_f=security_bridge/carplay-pairing-helper ;;
            PAIR_CORE) _y_f=security_bridge/libCarPlayPairingCore.so ;;
            WRAPPER) _y_f=dio_manager.wrapper.sh ;;
            *) continue ;;
        esac
        matches "$ROOT/$_y_f" "$_y_h" "$_y_s" || return 1
    done <<EOF
$MANIFEST
EOF
    return 0
}

# Main menu 2: the CarPlay map (layout ARG). Factory unit: install. Our install with intact map files: the layout is
# switched to ARG when it is another one. Our install whose map files are mixed (the dio_manager wrapper is not this
# card's): everything is removed with the verified factory copies (restore), then the map is installed.
# Another mod or files restore cannot verify: nothing is written.
do_map_install() {
    key=`variant_key "$ARG"`
    [ -n "$key" ] || fail "UNKNOWN_VARIANT_$ARG"
    selftest
    firmware_identity
    detect_state
    case "$STATE" in
        STOCK) do_install; return 0 ;;
        UNKNOWN) [ -n "$STATE_WHY" ] && say "  $STATE_WHY"; fail "MAP_INSTALL_NOT_A_PMCP_INSTALL_NOTHING_CHANGED" ;;
    esac
    if [ "$MAPOK" = yes ] && map_files_ok; then
        set -- `manifest_get "$key"`
        if [ "`cat "$ROOT/VARIANT" 2>/dev/null`" = "$ARG" ] && matches "$ROOT/core.so" "$1" "$2"; then
            say "PMCP_MAP_INSTALL_OK (already installed: variant $ARG, nothing changed)"
            return 0
        fi
        do_switch
        return 0
    fi
    # before any write: this card's payload, and a factory copy with the factory hash for every live file restore puts
    # back (lsd.sh and dio_manager: pmcp_root)
    verify_payload
    pmcp_root || fail "MAP_INSTALL_FACTORY_COPIES_NOT_VERIFIED_NOTHING_CHANGED"
    matches "$GAL" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" || matches "$ROOT/aa/gal.real" "$STOCK_GAL_SHA" "$STOCK_GAL_SIZE" \
        || fail "MAP_INSTALL_FACTORY_GAL_COPY_NOT_VERIFIED_NOTHING_CHANGED"
    matches "$DRV" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" || matches "$ROOT/rollback/ipod-drvr-iap2.so" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" \
        || fail "MAP_INSTALL_FACTORY_IAP2_DRIVER_COPY_NOT_VERIFIED_NOTHING_CHANGED"
    matches "$CFG" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE" || matches "$ROOT/rollback/iap2.cfg" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE" \
        || fail "MAP_INSTALL_FACTORY_IAP2_CFG_COPY_NOT_VERIFIED_NOTHING_CHANGED"
    say "The CarPlay map files are mixed or of a version this card does not support:"
    say "removing everything first (verified factory files), then installing the map."
    do_restore
    do_install
    say "Android Auto and the additional features were removed with it: press 3 and/or 4 now, then restart."
}

# listed_pmcp_jars "HMI_BOOT line" -> the JAR names of that set that are ours by name (pmcp-*.jar, plain file names),
# also those of a package this card does not know; any other name (a factory or another mod's file) is never listed
listed_pmcp_jars() {
    set -f   # the set's words are data: no file name expansion
    set -- $1
    [ $# -gt 0 ] && shift
    for _l_w in "$@"; do
        case "$_l_w" in *[!A-Za-z0-9._-]*) ;; pmcp-*.jar) echo "$_l_w" ;; esac
    done
    set +f
}

# Main menu 4 runs this first: route guidance or Java files of a version this card does not support (an unknown
# Java set, a set switched off by the rescue card with the factory lsd.sh, an unknown driver or reader) are removed
# with the verified factory copies, so the steps after it install this card's set. Nothing to do: *_ALREADY_*.
java_reset() {
    _z_line=`cat "$ROOT/HMI_BOOT" 2>/dev/null`
    clear_speedlimit_mode
    if ! matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE"; then
        rm -f "$LSD.pmcp-rb" 2>/dev/null
        cp "$ROOT/rollback/lsd.sh" "$LSD.pmcp-rb" || fail "LSD_RESTORE_STAGE_FAILED"
        chmod 755 "$LSD.pmcp-rb" || fail "CHMOD_FAILED"
        check "$LSD.pmcp-rb" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" STAGED_FACTORY_LSD
        mv "$LSD.pmcp-rb" "$LSD" || fail "LSD_RESTORE_FAILED_RUN_RESTORE"
    fi
    # JAR files (the lsd.sh block is off now, nothing loads them), then the set file: until it goes, its names are known: every name this card knows (its own and earlier cards'), and the pmcp-*.jar names the old set listed
    _z_files=`java_catalog | while read _z_n _z_f; do echo "$_z_f"; done; echo "$JAVA_OLD" | while read _z_a _z_b _z_c _z_f _z_d; do [ -n "$_z_f" ] && echo "$_z_f"; done`
    _z_files="$_z_files `listed_pmcp_jars "$_z_line"`"
    set -f   # names are data: no file name expansion
    for _z_f in $_z_files; do
        rm -f "$JARS/$_z_f" "$JARS/$_z_f.pmcp-new" || { set +f; fail "JAR_REMOVE_FAILED_RUN_RESTORE"; }
    done
    set +f
    rm -f "$ROOT/HMI_BOOT" "$ROOT/HMI_BOOT.pmcp-new" "$LSD.pmcp-new" || fail "SET_REMOVE_FAILED_RUN_RESTORE"
}

do_features_reset() {
    selftest
    firmware_identity
    detect_state
    if [ "$MAPOK" != yes ]; then
        [ -n "$STATE_WHY" ] && say "  $STATE_WHY"
        fail "FEATURES_NEED_THE_CARPLAY_MAP_FIRST_PRESS_2_STATE_$STATE"
    fi
    if [ "$CORE_STATE" != PARTIAL ]; then
        # nothing of ours to reset; unsupported Android Auto files stop the next steps, so say it here
        [ "$AASYS" != unknown ] || fail "FEATURES_NEED_ANDROID_AUTO_REPLACED_FIRST_PRESS_3"
        fail "FEATURES_RESET_ALREADY_NOT_NEEDED"
    fi
    # the rg package without its route guidance system would run with the factory driver: reset the set with it
    _x_java=$JAVAPART
    if [ "$RGSYS" = unknown ] && [ "$JAVAPART" = set ]; then
        case " `current_set` " in *" rg"*) _x_java=mixed ;; esac
    fi
    # before any write: every live file that goes back needs a factory copy with the factory hash (lsd.sh: pmcp_root),
    # and lsd.sh must be the factory one or ours (another mod's lsd.sh is not replaced)
    if [ "$_x_java" = mixed ]; then
        set -- `manifest_get LSD_JAVA`
        matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" || matches "$LSD" "$1" "$2" \
            || fail "FEATURES_RESET_LSD_SH_IS_NOT_OURS_NOTHING_CHANGED"
    fi
    if [ "$RGSYS" = unknown ]; then
        matches "$DRV" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" || matches "$ROOT/rollback/ipod-drvr-iap2.so" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" \
            || fail "FEATURES_RESET_FACTORY_IAP2_DRIVER_COPY_NOT_VERIFIED_NOTHING_CHANGED"
        matches "$CFG" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE" || matches "$ROOT/rollback/iap2.cfg" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE" \
            || fail "FEATURES_RESET_FACTORY_IAP2_CFG_COPY_NOT_VERIFIED_NOTHING_CHANGED"
    fi
    say "Route guidance or Java files of a version this card does not support: removing them first (verified factory files)"
    remount_rw
    if [ "$_x_java" = mixed ]; then
        say "  Java set -> factory lsd.sh, our JAR files removed"
        java_reset
    fi
    if [ "$RGSYS" = unknown ]; then
        say "  route guidance system -> factory iAP2 driver and iap2.cfg"
        rg_files_off
    fi
    detect_state
    case "$CORE_STATE" in VIDEO|JAVA) ;; *) fail "POST_FEATURES_RESET_STATE_${STATE}_PRESS_8_REMOVE_EVERYTHING" ;; esac
    flush
    say "PMCP_FEATURES_RESET_OK (state now $STATE)"
    [ "$AASYS" = unknown ] && say "Android Auto files of a version this card does not support: 3. Install Android Auto, then 4 again."
    return 0
}

# CarPlay log for the log card (card 3): the supervisor log and the route guidance status of this start (in /ramdisk,
# gone at the next start) and pmcp's boot log, to carplaymaps/logs like the AA log
CP_LOG_MAX=5
do_cp_log_save() {
    selftest
    firmware_identity
    detect_state
    case "$STATE" in VIDEO|JAVA|PARTIAL) ;; *) fail "CP_LOG_NEEDS_PMCP_STATE_$STATE" ;; esac
    _l_n=1
    while [ -e "$ROOT/logs/cp-log-$_l_n.txt" ]; do
        _l_n=$((_l_n + 1))
        [ $_l_n -le $CP_LOG_MAX ] || fail "CP_LOGS_FULL_${CP_LOG_MAX}_USE_THE_LOG_CARD_THEN_DELETE_SAVED_LOGS"
    done
    remount_rw
    mkdir -p "$ROOT/logs" || fail "CP_LOG_DIR_FAILED"
    _l_f="$ROOT/logs/cp-log-$_l_n.txt"
    rm -f "$_l_f.pmcp-new" 2>/dev/null
    if ! { echo "pmcp $PMCP_VERSION cp-log-save `date 2>/dev/null`"
           echo "--- state: $STATE (map $MAPOK, Java $JAVAPART, route guidance $RGSYS, Android Auto $AASYS)"
           [ -n "$STATE_WHY" ] && echo "    $STATE_WHY"
           # the card that last wrote the CarPlay map stream (2 with the same core.so answers "already installed" and keeps it)
           echo "--- map stream installed by card: `cat "$ROOT/PMCP_VERSION" 2>/dev/null` variant `cat "$ROOT/VARIANT" 2>/dev/null`"
           echo "--- HMI_BOOT: `cat "$ROOT/HMI_BOOT" 2>/dev/null`"
           echo "--- markers: `ls "$PERSIST" 2>/dev/null`"
           echo "--- last-boot: `cat "$PERSIST/last-boot" 2>/dev/null`"
           echo "--- boot.log"; cat "$PERSIST/boot.log" 2>/dev/null
           echo "--- carplay-cluster-supervisor.log"; cat "$RAMDISK/carplay-cluster-supervisor.log" 2>/dev/null
           # the supervisor's copy of the last exited bridge / supervisor run (e.g. "MOST write failed: ..." at boot)
           for _l_x in last-bridge.log last-supervisor.log; do
               echo "--- carplaymaps-diagnostics/$_l_x (first 200 lines)"
               sed -n '1,200p' "$RAMDISK/carplaymaps-diagnostics/$_l_x" 2>/dev/null
           done
           for _l_x in adapter-status.txt guidance-evidence.txt; do
               echo "--- carplay-route-guidance/$_l_x"; cat "$RAMDISK/carplay-route-guidance/$_l_x" 2>/dev/null
           done
           echo "--- pmcp-speedlimit.state"; cat "$SL_STATE" 2>/dev/null
           echo "--- end"; } > "$_l_f.pmcp-new" 2>/dev/null; then
        rm -f "$_l_f.pmcp-new" 2>/dev/null
        fail "CP_LOG_WRITE_FAILED"
    fi
    _l_have=`size_of "$_l_f.pmcp-new"`
    [ -n "$_l_have" ] && [ "$_l_have" -gt 0 ] || { rm -f "$_l_f.pmcp-new"; fail "CP_LOG_WRITE_FAILED"; }
    mv "$_l_f.pmcp-new" "$_l_f" || fail "CP_LOG_RENAME_FAILED"
    flush
    _l_sup=no; [ -s "$RAMDISK/carplay-cluster-supervisor.log" ] && _l_sup=yes
    say "PMCP_CP_LOG_SAVED file=logs/cp-log-$_l_n.txt bytes=$_l_have supervisor_log=$_l_sup"
    say "To the computer: log card (card 3) in update mode. Up to $CP_LOG_MAX CarPlay logs are kept."
}

# stage_set_files "names" -> stages HMI_BOOT.pmcp-new in ROOT (ids from the manifest), checks it reads back
stage_set_files() {
    _s_names="$1"; _s_jars=""; _s_id=""
    for _s_n in $_s_names; do
        set -- `manifest_get "JAR_$_s_n"`
        [ -n "$1" ] || fail "UNKNOWN_JAVA_PACKAGE_$_s_n"
        _s_jars="$_s_jars${_s_jars:+ }${3##*/}"; _s_id="$_s_id${_s_id:++}$_s_n-`first8 $1`"
    done
    echo "$_s_id $_s_jars" > "$ROOT/HMI_BOOT.pmcp-new" || fail "SET_STAGE_FAILED"
    [ "`cat "$ROOT/HMI_BOOT.pmcp-new" 2>/dev/null`" = "$_s_id $_s_jars" ] || fail "SET_STAGE_READBACK_FAILED"
}

# one rename: the boot sees either the old set or the new one, never a mix
commit_set_files() {
    mv "$ROOT/HMI_BOOT.pmcp-new" "$ROOT/HMI_BOOT"
}

do_java_on() {
    JFILE=`java_jarfile "$ARG"`
    [ -n "$JFILE" ] || fail "UNKNOWN_JAVA_PACKAGE_$ARG"
    selftest
    firmware_identity
    detect_state
    case "$STATE" in VIDEO|JAVA) ;; *) fail "JAVA_NEEDS_STAGE_A_STATE_$STATE" ;; esac
    cur=`current_set`
    [ "$STATE" = VIDEO ] && cur=""
    [ -z "$JAVA_OLD_SET" ] || fail "JAVA_SET_HAS_OLD_PACKAGES_RUN_JAVA_UPDATE_FIRST"
    case " $cur " in *" $ARG "*) fail "JAVA_PACKAGE_ALREADY_ON_$ARG" ;; esac
    case "$ARG" in rg) [ "$RGSYS" = on ] || fail "JAVA_RG_NEEDS_RG_SYSTEM_ON_$RGSYS" ;; esac
    # new set in catalog order, so the same packages always give the same set id
    new=""
    for n in `java_catalog | while read a b; do echo $a; done`; do
        case " $cur $ARG " in *" $n "*) new="$new${new:+ }$n" ;; esac
    done
    set -- `manifest_get "JAR_$ARG"`; J_SHA=$1; J_SIZE=$2; J_PATH=$3
    set -- `manifest_get LSD_JAVA`; LJ_SHA=$1; LJ_SIZE=$2; LJ_PATH=$3
    check "$PAYLOAD/$J_PATH" "$J_SHA" "$J_SIZE" "JAR_$ARG"
    check "$PAYLOAD/$LJ_PATH" "$LJ_SHA" "$LJ_SIZE" LSD_JAVA
    remount_rw
    # A newly installed reader always starts with output off, even after a stale configuration file.
    [ "$ARG" != sl ] || clear_speedlimit_mode
    rm -f "$JARS/$JFILE.pmcp-new" "$LSD.pmcp-new" "$ROOT"/*.pmcp-new 2>/dev/null
    cp "$PAYLOAD/$J_PATH" "$JARS/$JFILE.pmcp-new" || fail "JAR_STAGE_FAILED"
    chmod 644 "$JARS/$JFILE.pmcp-new" || fail "CHMOD_FAILED"
    check "$JARS/$JFILE.pmcp-new" "$J_SHA" "$J_SIZE" "STAGED_JAR_$ARG"
    if [ "$STATE" = VIDEO ]; then
        cp "$PAYLOAD/$LJ_PATH" "$LSD.pmcp-new" || fail "LSD_STAGE_FAILED"
        chmod 755 "$LSD.pmcp-new" || fail "CHMOD_FAILED"
        check "$LSD.pmcp-new" "$LJ_SHA" "$LJ_SIZE" STAGED_LSD_JAVA
        matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" || fail "LSD_CHANGED_DURING_JAVA_ON"
    fi
    stage_set_files "$new"
    # Order: JAR, then HMI_BOOT (a new set id means a fresh trial boot), lsd.sh last as the switch.
    mv "$JARS/$JFILE.pmcp-new" "$JARS/$JFILE" || fail "JAR_ACTIVATION_FAILED"
    commit_set_files || fail "SET_ACTIVATION_FAILED_RUN_RESTORE"
    if [ "$STATE" = VIDEO ]; then
        mv "$LSD.pmcp-new" "$LSD" || fail "LSD_ACTIVATION_FAILED_RUN_RESTORE"
    fi
    rm -f "$PERSIST/DISABLED" 2>/dev/null
    detect_state
    [ "$STATE" = JAVA ] || fail "POST_JAVA_ON_STATE_${STATE}_RUN_RESTORE"
    flush
    say "PMCP_JAVA_ON_OK package=$ARG set=`boot_set_id`"
    say "Reboot the unit. The first boot is a trial: if everything works, press 5. Confirm in GEM during that boot."
    say "Without it, or if the screen does not come back (hold the volume knob ~10 s), the next boot is factory."
}

do_java_off() {
    JFILE=`java_jarfile "$ARG"`
    [ -n "$JFILE" ] || fail "UNKNOWN_JAVA_PACKAGE_$ARG"
    selftest
    firmware_identity
    detect_state
    [ "$STATE" = JAVA ] || fail "JAVA_OFF_NEEDS_JAVA_STATE_$STATE"
    [ -z "$JAVA_OLD_SET" ] || fail "JAVA_SET_HAS_OLD_PACKAGES_RUN_JAVA_UPDATE_FIRST"
    cur=`current_set`
    case " $cur " in *" $ARG "*) ;; *) fail "JAVA_PACKAGE_NOT_ON_$ARG" ;; esac
    new=""
    for n in $cur; do [ "$n" = "$ARG" ] || new="$new${new:+ }$n"; done
    remount_rw
    # The currently loaded helper sees the absent mode and restores factory text before the reboot.
    [ "$ARG" != sl ] || clear_speedlimit_mode
    # turnto shows only through rg's TurnToInfo text: without rg it would be a saved mode that shows nothing and comes
    # back silently with a later java-on rg
    if [ "$ARG" = rg ] && [ "`cat "$SL_MODE" 2>/dev/null`" = turnto ]; then clear_speedlimit_mode; fi
    if [ -z "$new" ]; then
        # last package: factory lsd.sh first (switch off), then remove the JAR and set files
        cp "$ROOT/rollback/lsd.sh" "$LSD.pmcp-rb" || fail "LSD_RESTORE_STAGE_FAILED"
        chmod 755 "$LSD.pmcp-rb" || fail "CHMOD_FAILED"
        check "$LSD.pmcp-rb" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" STAGED_FACTORY_LSD
        mv "$LSD.pmcp-rb" "$LSD" || fail "LSD_RESTORE_FAILED"
        rm -f "$JARS/$JFILE" "$ROOT/HMI_BOOT" || fail "JAR_REMOVE_FAILED_RUN_RESTORE"
        detect_state
        [ "$STATE" = VIDEO ] || fail "POST_JAVA_OFF_STATE_${STATE}_RUN_RESTORE"
    else
        # HMI_BOOT first (the JAR is then no longer referenced), then remove the JAR
        stage_set_files "$new"
        commit_set_files || fail "SET_ACTIVATION_FAILED_RUN_RESTORE"
        rm -f "$JARS/$JFILE" || fail "JAR_REMOVE_FAILED_RUN_RESTORE"
        detect_state
        [ "$STATE" = JAVA ] || fail "POST_JAVA_OFF_STATE_${STATE}_RUN_RESTORE"
    fi
    flush
    say "PMCP_JAVA_OFF_OK package=$ARG"
    say "A full unit reboot is required."
}

# The user pressed a GEM button during the trial boot, so the HMI runs with this set: make it permanent.
# Only during that boot: lsd.sh writes last-boot on every boot (removed first, also when nothing loads), and it
# must say this set id with use=trial. A factory boot after a failed trial (use=no) can never confirm the set.
do_java_confirm() {
    selftest
    firmware_identity
    detect_state
    [ "$STATE" = JAVA ] || fail "JAVA_CONFIRM_NEEDS_JAVA_STATE_$STATE"
    set_id=`boot_set_id`
    [ ! -e "$PERSIST/DISABLED" ] || fail "JAVA_DISABLED_BY_RESCUE_CARD"
    [ -e "$PERSIST/ok.$set_id" ] && fail "SET_ALREADY_CONFIRMED_$set_id"
    [ -e "$PERSIST/trial.$set_id" ] || fail "NO_TRIAL_BOOT_YET_FOR_SET_$set_id"
    [ "`cat "$PERSIST/last-boot" 2>/dev/null`" = "set=$set_id use=trial" ] \
        || fail "NOT_IN_TRIAL_BOOT_OF_THIS_SET_USE_java-retry_AND_REBOOT"
    touch "$PERSIST/ok.$set_id" || fail "CONFIRM_MARKER_FAILED"
    echo "gem-ok set=$set_id" >> "$PERSIST/boot.log" 2>/dev/null
    flush
    say "PMCP_JAVA_CONFIRM_OK set=$set_id (this set now loads on every boot)"
}

do_java_retry() {
    selftest
    firmware_identity
    detect_state
    [ "$STATE" = JAVA ] || fail "JAVA_RETRY_NEEDS_JAVA_STATE_$STATE"
    set_id=`boot_set_id`
    rm -f "$PERSIST/trial.$set_id" "$PERSIST/DISABLED" || fail "RETRY_MARKER_REMOVE_FAILED"
    flush
    say "PMCP_JAVA_RETRY_OK set=$set_id (the next boot is a new trial)"
}

# java-update: the set holds packages of an earlier card (JAVA_OLD). One new set with this card's packages: each old one
# becomes its successor (rg, rglu, rg-aa and the other earlier rg variants -> rg), the others stay. New JARs have file names no
# earlier card used, so the old set stays intact until HMI_BOOT switches (one mv); old JARs are removed after it.
do_java_update() {
    selftest
    firmware_identity
    detect_state
    # "ALREADY" answers let button 4 skip this step on units without a Java set or already current.
    case "$STATE" in STOCK|VIDEO) fail "JAVA_UPDATE_ALREADY_NO_JAVA_SET" ;; JAVA) ;; *)
        [ -n "$STATE_WHY" ] && say "  $STATE_WHY"
        [ "$AASYS" = unknown ] && fail "JAVA_UPDATE_NEEDS_ANDROID_AUTO_REPLACED_FIRST_PRESS_3"
        fail "JAVA_UPDATE_NEEDS_JAVA_STATE_$STATE" ;; esac
    if [ -z "$JAVA_OLD_SET" ]; then
        [ -n "$JAVA_STRAY" ] || fail "JAVA_UPDATE_ALREADY_CURRENT"
        # only unreferenced JARs left (an interrupted update after its HMI_BOOT switch): remove them, the set stays
        remount_rw
        for f in $JAVA_STRAY; do rm -f "$JARS/$f" || fail "STRAY_JAR_REMOVE_FAILED"; done
        detect_state
        [ "$STATE" = JAVA ] && [ -z "$JAVA_STRAY" ] || fail "POST_JAVA_UPDATE_STATE_${STATE}_RUN_RESTORE"
        flush
        say "PMCP_JAVA_UPDATE_OK set=`boot_set_id` (unused JARs of an interrupted update removed; the set is unchanged)"
        exit 0
    fi
    cur=`current_set`; want=""; oldfiles=""
    _u_x=`boot_set_id`
    while :; do
        _u_part=${_u_x%%+*}; _u_n=${_u_part%-*}
        set -- `java_old "$_u_n" "${_u_part##*-}"`
        if [ -n "$1" ]; then
            want="$want $4"; oldfiles="$oldfiles $3"
        else
            want="$want $_u_n"
        fi
        [ "$_u_part" = "$_u_x" ] && break
        _u_x=${_u_x#*+}
    done
    case " $want " in *" rg "*) [ "$RGSYS" = on ] || fail "JAVA_UPDATE_NEEDS_RG_SYSTEM_ON_$RGSYS" ;; esac
    new=""
    for n in `java_catalog | while read a b; do echo $a; done`; do
        case " $want " in *" $n "*) new="$new${new:+ }$n" ;; esac
    done
    remount_rw
    rm -f "$ROOT/HMI_BOOT.pmcp-new" 2>/dev/null
    staged=""
    for n in $new; do
        set -- `manifest_get "JAR_$n"`; J_SHA=$1; J_SIZE=$2; J_PATH=$3; J_FILE=${3##*/}
        matches "$JARS/$J_FILE" "$J_SHA" "$J_SIZE" && continue
        check "$PAYLOAD/$J_PATH" "$J_SHA" "$J_SIZE" "JAR_$n"
        rm -f "$JARS/$J_FILE.pmcp-new" 2>/dev/null
        cp "$PAYLOAD/$J_PATH" "$JARS/$J_FILE.pmcp-new" || fail "JAR_STAGE_FAILED"
        chmod 644 "$JARS/$J_FILE.pmcp-new" || fail "CHMOD_FAILED"
        check "$JARS/$J_FILE.pmcp-new" "$J_SHA" "$J_SIZE" "STAGED_JAR_$n"
        staged="$staged $J_FILE"
    done
    stage_set_files "$new"
    # Order: new JARs (not referenced yet), HMI_BOOT (new set id = a fresh trial boot), then the old JARs go.
    for f in $staged; do mv "$JARS/$f.pmcp-new" "$JARS/$f" || fail "JAR_ACTIVATION_FAILED_RUN_RESTORE"; done
    commit_set_files || fail "SET_ACTIVATION_FAILED_RUN_RESTORE"
    newfiles=`cat "$ROOT/HMI_BOOT"`
    for f in $oldfiles $JAVA_STRAY; do
        case " $newfiles " in *" $f "*) continue ;; esac
        rm -f "$JARS/$f" || fail "OLD_JAR_REMOVE_FAILED_RUN_JAVA_UPDATE_AGAIN"
    done
    rm -f "$PERSIST/DISABLED" 2>/dev/null
    detect_state
    [ "$STATE" = JAVA ] && [ -z "$JAVA_OLD_SET" ] && [ -z "$JAVA_STRAY" ] || fail "POST_JAVA_UPDATE_STATE_${STATE}_RUN_JAVA_UPDATE_AGAIN"
    flush
    say "  was:$want (from: $cur)"
    say "PMCP_JAVA_UPDATE_OK set=`boot_set_id`"
    say "Reboot the unit. The first boot is a trial: if everything works, press 5. Confirm in GEM during that boot."
    say "Without it, or if the screen does not come back (hold the volume knob ~10 s), the next boot is factory."
}

do_speedlimit_mode() {
    case "$ARG" in off|street|turnto) ;; *) fail "UNKNOWN_SPEEDLIMIT_MODE_$ARG" ;; esac
    if [ "$ARG" != off ]; then
        selftest
        firmware_identity
        detect_state
        [ "$STATE" = JAVA ] || fail "SPEEDLIMIT_NEEDS_JAVA_STATE_$STATE"
        case " `current_set` " in *" sl "*) ;; *) fail "SPEEDLIMIT_PACKAGE_NOT_INSTALLED" ;; esac
        # since v1.4 rg owns TurnToInfo and adds the prefix (rg/lanes/SpeedLimitText.java): without rg nothing shows it
        if [ "$ARG" = turnto ]; then
            case " `current_set` " in *" rg "*) ;; *) fail "SPEEDLIMIT_TURNTO_NEEDS_RG_PACKAGE" ;; esac
        fi
        set_id=`boot_set_id`
        [ ! -e "$PERSIST/DISABLED" ] || fail "JAVA_DISABLED_BY_RESCUE_CARD"
        [ -e "$PERSIST/ok.$set_id" ] || fail "SPEEDLIMIT_CONFIRM_JAVA_SET_FIRST"
        case "`cat "$PERSIST/last-boot" 2>/dev/null`" in
            "set=$set_id use=yes"|"set=$set_id use=trial") ;;
            *) fail "SPEEDLIMIT_NOT_RUNNING_THIS_SET_REBOOT_FIRST" ;;
        esac
    elif [ ! -e "$SL_MODE" ]; then
        say "PMCP_SPEEDLIMIT_MODE_OK mode=off (no configuration file)"
        return
    fi
    [ -d "$PERSIST" ] || fail "SPEEDLIMIT_PERSIST_DIRECTORY_MISSING"
    [ ! -d "$SL_MODE" ] || fail "SPEEDLIMIT_MODE_IS_DIRECTORY"
    rm -f "$SL_MODE.pmcp-new" || fail "SPEEDLIMIT_MODE_STAGE_CLEANUP_FAILED"
    ( echo "$ARG" > "$SL_MODE.pmcp-new" ) || fail "SPEEDLIMIT_MODE_STAGE_FAILED"
    mv "$SL_MODE.pmcp-new" "$SL_MODE" || fail "SPEEDLIMIT_MODE_COMMIT_FAILED"
    flush
    say "PMCP_SPEEDLIMIT_MODE_OK mode=$ARG (saved across reboots)"
    say "The reader applies the mode on its next poll. Native limit data may arrive later."
}

do_speedlimit_status() {
    _sl_label="invalid (reader output is off)"
    if [ ! -e "$SL_MODE" ]; then
        _sl_label="off (default)"
    elif [ -f "$SL_MODE" ] && IFS= read -r _sl_saved < "$SL_MODE"; then
        # Match the helper's exact LF-terminated bytes, including one newline and no trailing data.
        case "$_sl_saved/`size_of "$SL_MODE"`" in
            off/4|street/7|turnto/7) _sl_label="$_sl_saved" ;;
        esac
    fi
    say "Saved native speed-limit mode: $_sl_label"
    if [ -s "$SL_STATE" ]; then
        say "Reader snapshot ($SL_STATE):"
        while IFS= read -r _sl_line; do say "  $_sl_line"; done < "$SL_STATE"
    else
        say "Reader snapshot unavailable (reader not started or no snapshot yet)."
    fi
    say "PMCP_SPEEDLIMIT_STATUS_OK"
}

do_rg_system_on() {
    selftest
    firmware_identity
    detect_state
    case "$STATE" in VIDEO|JAVA) ;; *) fail "RG_SYSTEM_NEEDS_STAGE_A_STATE_$STATE" ;; esac
    case "$RGSYS" in off) ;; on|old) fail "RG_SYSTEM_ALREADY_ON" ;; *) fail "RG_SYSTEM_ALREADY_$RGSYS" ;; esac
    set -- `manifest_get RG_DRIVER`; RD_SHA=$1; RD_SIZE=$2; RD_PATH=$3
    set -- `manifest_get RG_CFG`; RC_SHA=$1; RC_SIZE=$2; RC_PATH=$3
    set -- `manifest_get RG_READER`; RR_SHA=$1; RR_SIZE=$2; RR_PATH=$3
    check "$PAYLOAD/$RD_PATH" "$RD_SHA" "$RD_SIZE" RG_DRIVER
    check "$PAYLOAD/$RC_PATH" "$RC_SHA" "$RC_SIZE" RG_CFG
    check "$PAYLOAD/$RR_PATH" "$RR_SHA" "$RR_SIZE" RG_READER
    remount_rw
    remount_sys
    rm -rf "$RGDIR" 2>/dev/null
    rm -f "$DRV.pmcp-new" "$CFG.pmcp-new" "$ROOT/rollback/ipod-drvr-iap2.so" "$ROOT/rollback/iap2.cfg" 2>/dev/null
    mkdir -p "$RGDIR" || fail "RG_DIR_FAILED"
    say "Saving the factory iAP2 driver and iap2.cfg"
    cp "$DRV" "$ROOT/rollback/ipod-drvr-iap2.so" && cp "$CFG" "$ROOT/rollback/iap2.cfg" || fail "RG_BACKUP_FAILED"
    check "$ROOT/rollback/ipod-drvr-iap2.so" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" SAVED_FACTORY_DRIVER
    check "$ROOT/rollback/iap2.cfg" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE" SAVED_FACTORY_CFG
    say "Staging"
    cp "$PAYLOAD/$RR_PATH" "$RGDIR/rgi-observer" && chmod 755 "$RGDIR/rgi-observer" || fail "READER_STAGE_FAILED"
    cp "$PAYLOAD/$RD_PATH" "$DRV.pmcp-new" && chmod 755 "$DRV.pmcp-new" || fail "DRIVER_STAGE_FAILED"
    cp "$PAYLOAD/$RC_PATH" "$CFG.pmcp-new" && chmod 644 "$CFG.pmcp-new" || fail "CFG_STAGE_FAILED"
    check "$RGDIR/rgi-observer" "$RR_SHA" "$RR_SIZE" STAGED_READER
    check "$DRV.pmcp-new" "$RD_SHA" "$RD_SIZE" STAGED_DRIVER
    check "$CFG.pmcp-new" "$RC_SHA" "$RC_SIZE" STAGED_CFG
    # The reader only starts with SYSTEM_ON; the driver and cfg are a pair, SYSTEM_ON is written last.
    mv "$DRV.pmcp-new" "$DRV" || fail "DRIVER_ACTIVATION_FAILED_RUN_RG_SYSTEM_OFF"
    mv "$CFG.pmcp-new" "$CFG" || fail "CFG_ACTIVATION_FAILED_RUN_RESTORE"
    touch "$RGDIR/SYSTEM_ON" || fail "RG_MARKER_FAILED_RUN_RESTORE"
    remount_sys_ro
    rg_state
    [ "$RGSYS" = on ] || fail "POST_RG_SYSTEM_ON_$RGSYS"
    flush
    say "PMCP_RG_SYSTEM_ON_OK (then: Java package rg, full reboot)"
}

# rg-update: RG is on, but with an earlier card's driver and/or reader (RGSYS=old). Only those two files are replaced
# (staged, hashed, then mv each); iap2.cfg, SYSTEM_ON and the verified factory copies stay as they are.
# Idempotent: after an interruption between the two mv, running it again finishes the job.
do_rg_update() {
    selftest
    firmware_identity
    detect_state
    # "ALREADY" answers let button 4 skip this step on units without RG or already current.
    case "$STATE" in STOCK) fail "RG_UPDATE_ALREADY_NOT_INSTALLED" ;; VIDEO|JAVA|PARTIAL) ;; *) fail "RG_UPDATE_NEEDS_PMCP_STATE_$STATE" ;; esac
    case "$RGSYS" in old) ;; off) fail "RG_UPDATE_ALREADY_NOT_INSTALLED" ;; on) fail "RG_UPDATE_ALREADY_CURRENT" ;; *) fail "RG_UPDATE_UNKNOWN_RG_FILES" ;; esac
    _u_d=$DRV_NEW; _u_r=$RD_NEW
    set -- `manifest_get RG_DRIVER`; RD_SHA=$1; RD_SIZE=$2; RD_PATH=$3
    set -- `manifest_get RG_READER`; RR_SHA=$1; RR_SIZE=$2; RR_PATH=$3
    check "$PAYLOAD/$RD_PATH" "$RD_SHA" "$RD_SIZE" RG_DRIVER
    check "$PAYLOAD/$RR_PATH" "$RR_SHA" "$RR_SIZE" RG_READER
    remount_rw
    rm -f "$DRV.pmcp-new" "$RGDIR/rgi-observer.pmcp-new" 2>/dev/null
    say "Staging"
    if [ $_u_d = yes ]; then
        cp "$PAYLOAD/$RD_PATH" "$DRV.pmcp-new" && chmod 755 "$DRV.pmcp-new" || fail "DRIVER_STAGE_FAILED"
        check "$DRV.pmcp-new" "$RD_SHA" "$RD_SIZE" STAGED_DRIVER
    fi
    if [ $_u_r = yes ]; then
        cp "$PAYLOAD/$RR_PATH" "$RGDIR/rgi-observer.pmcp-new" && chmod 755 "$RGDIR/rgi-observer.pmcp-new" || fail "READER_STAGE_FAILED"
        check "$RGDIR/rgi-observer.pmcp-new" "$RR_SHA" "$RR_SIZE" STAGED_READER
    fi
    # The running reader keeps its old image; the new one starts at the next unit start (lsd.sh block).
    stop_reader
    if [ $_u_d = yes ]; then mv "$DRV.pmcp-new" "$DRV" || fail "DRIVER_ACTIVATION_FAILED_RUN_RG_UPDATE_AGAIN"; fi
    if [ $_u_r = yes ]; then mv "$RGDIR/rgi-observer.pmcp-new" "$RGDIR/rgi-observer" || fail "READER_ACTIVATION_FAILED_RUN_RG_UPDATE_AGAIN"; fi
    rg_state
    [ "$RGSYS" = on ] || fail "POST_RG_UPDATE_$RGSYS"
    flush
    say "  driver: `[ $_u_d = yes ] && echo replaced || echo already current`, reader: `[ $_u_r = yes ] && echo replaced || echo already current`"
    say "PMCP_RG_UPDATE_OK (full reboot needed; way back: rg-system-off, then rg-system-on from the card you want)"
}

# put the factory driver and cfg back if needed, remove reader and marker (used by rg-system-off and restore)
rg_files_off() {
    stop_reader
    rm -f "$RGDIR/SYSTEM_ON" 2>/dev/null
    if ! matches "$DRV" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE"; then
        [ -f "$ROOT/rollback/ipod-drvr-iap2.so" ] || fail "FACTORY_DRIVER_COPY_MISSING"
        remount_rw
        cp "$ROOT/rollback/ipod-drvr-iap2.so" "$DRV.pmcp-restore" && chmod 755 "$DRV.pmcp-restore" || fail "DRIVER_RESTORE_STAGE_FAILED"
        check "$DRV.pmcp-restore" "$STOCK_DRV_SHA" "$STOCK_DRV_SIZE" STAGED_FACTORY_DRIVER
        mv "$DRV.pmcp-restore" "$DRV" || fail "DRIVER_RESTORE_FAILED"
    fi
    if ! matches "$CFG" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE"; then
        [ -f "$ROOT/rollback/iap2.cfg" ] || fail "FACTORY_CFG_COPY_MISSING"
        remount_sys
        cp "$ROOT/rollback/iap2.cfg" "$CFG.pmcp-restore" && chmod 644 "$CFG.pmcp-restore" || fail "CFG_RESTORE_STAGE_FAILED"
        check "$CFG.pmcp-restore" "$STOCK_CFG_SHA" "$STOCK_CFG_SIZE" STAGED_FACTORY_CFG
        mv "$CFG.pmcp-restore" "$CFG" || fail "CFG_RESTORE_FAILED"
        remount_sys_ro
    fi
    rm -f "$DRV.pmcp-new" "$CFG.pmcp-new" 2>/dev/null
    rm -rf "$RGDIR" "$ROOT/rollback/ipod-drvr-iap2.so" "$ROOT/rollback/iap2.cfg" 2>/dev/null
}

do_rg_system_off() {
    selftest
    firmware_identity
    detect_state
    case "$STATE" in VIDEO|JAVA|PARTIAL) ;; *) fail "RG_SYSTEM_OFF_NEEDS_PMCP_STATE_$STATE" ;; esac
    if [ "$STATE" = JAVA ]; then
        for _y_n in `current_set`; do
            case "$_y_n" in rg*) fail "TURN_OFF_JAVA_PACKAGE_RG_FIRST" ;; esac
        done
    fi
    remount_rw
    rg_files_off
    rg_state
    [ "$RGSYS" = off ] || fail "POST_RG_SYSTEM_OFF_$RGSYS"
    flush
    say "PMCP_RG_SYSTEM_OFF_OK (factory iAP2 driver and iap2.cfg verified)"
    say "A full unit reboot is required."
}

do_restore() {
    selftest
    firmware_identity
    # Android Auto goes first (its factory gal copy lives in carplaymaps, removed below)
    if [ -d "$ROOT" ] && aa_present && pmcp_root; then
        say "Android Auto: taking it off first"
        aa_off
    fi
    detect_state
    case "$STATE" in
        VIDEO|JAVA|PARTIAL) ;;
        *) fail "RESTORE_NEEDS_PMCP_INSTALL_STATE_$STATE" ;;
    esac
    remount_rw
    stop_runtime
    # Idempotent: each live file is replaced only if it is not already the factory file. lsd.sh first:
    # it is what the HMI reads at start.
    if ! matches "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE"; then
        cp "$ROOT/rollback/lsd.sh" "$LSD.pmcp-restore" || fail "LSD_RESTORE_STAGE_FAILED"
        chmod 755 "$LSD.pmcp-restore" || fail "CHMOD_FAILED"
        check "$LSD.pmcp-restore" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" STAGED_FACTORY_LSD
        mv "$LSD.pmcp-restore" "$LSD" || fail "LSD_RESTORE_FAILED"
    fi
    if ! matches "$DIO" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE"; then
        cp "$ROOT/stock_first/dio_manager.real" "$DIO.pmcp-restore" || fail "DIO_RESTORE_STAGE_FAILED"
        chmod 755 "$DIO.pmcp-restore" || fail "CHMOD_FAILED"
        check "$DIO.pmcp-restore" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" STAGED_FACTORY_DIO
        mv "$DIO.pmcp-restore" "$DIO" || fail "DIO_RESTORE_FAILED"
    fi
    _r_set=`cat "$ROOT/HMI_BOOT" 2>/dev/null`
    for f in `java_catalog | while read n j; do echo $j; done` `echo "$JAVA_OLD" | while read a b c j d; do echo $j; done` \
             `listed_pmcp_jars "$_r_set"`; do
        rm -f "$JARS/$f" "$JARS/$f.pmcp-new" || fail "JAR_REMOVE_FAILED"
    done
    rm -f "$LSD.pmcp-new" "$DIO.pmcp-new" "$LSD.pmcp-rb" "$DIO.pmcp-rb" 2>/dev/null
    rg_files_off
    check "$DIO" "$STOCK_DIO_SHA" "$STOCK_DIO_SIZE" FACTORY_DIO
    [ -x "$DIO" ] || fail "FACTORY_DIO_NOT_EXECUTABLE"
    check "$LSD" "$STOCK_LSD_SHA" "$STOCK_LSD_SIZE" FACTORY_LSD
    # trial/ok markers before carplaymaps: while carplaymaps exists, an interrupted restore can be run again
    rm -rf "$PERSIST" 2>/dev/null
    [ ! -e "$PERSIST" ] || fail "TRIAL_MARKERS_REMOVE_FAILED"
    remove_root || fail "ROOT_REMOVE_FAILED"
    remove_stale
    detect_state
    [ "$STATE" = STOCK ] || fail "POST_RESTORE_STATE_$STATE"
    flush
    say "PMCP_RESTORE_OK (factory lsd.sh and dio_manager verified)"
    say "A full unit reboot is required."
}

do_status() {
    firmware_identity
    detect_state
    say "Unit state: $STATE"
    [ -n "$STATE_WHY" ] && say "  $STATE_WHY"
    [ -s "$ROOT/PMCP_VERSION" ] && say "Installed: `cat "$ROOT/PMCP_VERSION"` variant `cat "$ROOT/VARIANT" 2>/dev/null`"
    [ "$STATE" = JAVA ] && say "Java set: `boot_set_id`"
    [ -n "$JAVA_OLD_SET" ] && say "  packages of an earlier card: $JAVA_OLD_SET (4. Install additional features replaces them)"
    [ -n "$JAVA_STRAY" ] && say "  unused JAR files (not loaded): $JAVA_STRAY (4. Install additional features removes them)"
    say "Route guidance system: $RGSYS"
    [ "$RGSYS" = old ] && say "  driver or reader of an earlier card (4. Install additional features replaces them)"
    say "Android Auto: $AASYS${AAMODE:+ mode=$AAMODE}"
    if [ -d "$PERSIST" ]; then
        say "Trial markers: `ls "$PERSIST" 2>/dev/null`"
        [ -s "$PERSIST/last-boot" ] && say "This boot: `cat "$PERSIST/last-boot"`"
        if [ -s "$PERSIST/boot.log" ]; then
            say "Boot log (/mnt/persist/pmcp/boot.log):"
            while read l; do say "  $l"; done < "$PERSIST/boot.log"
        fi
    fi
    say "PMCP_STATUS_OK"
}

say "pmcp $PMCP_VERSION: $ACTION $ARG"
# Sharing this lock prevents an enable check from racing with a Java-set change or a full restore.
case "$ACTION" in
    speedlimit-mode|java-on|java-off|java-update|features-reset) speedlimit_lock ;;
esac
case "$ACTION" in
    verify)     do_verify ;;
    install)    do_install ;;
    map-install)    do_map_install ;;
    aa-install)     do_aa_install ;;
    features-reset) do_features_reset ;;
    confirm)    do_confirm ;;
    retry)      do_retry ;;
    cp-log-save)    do_cp_log_save ;;
    switch)     do_switch ;;
    java-on)    do_java_on ;;
    java-off)   do_java_off ;;
    java-retry) do_java_retry ;;
    java-confirm) do_java_confirm ;;
    rg-system-on)  do_rg_system_on ;;
    rg-system-off) do_rg_system_off ;;
    rg-update)     do_rg_update ;;
    java-update)   do_java_update ;;
    aa-remove)     do_aa_remove ;;
    aa-on)         do_aa_on ;;
    aa-confirm)    do_aa_confirm ;;
    aa-retry)      do_aa_retry ;;
    aa-status)     do_aa_status ;;
    aa-log-save)   do_aa_log_save ;;
    aa-log-clear)  do_aa_log_clear ;;
    aa-on-exp)     do_aa_install gammax ;;
    aa-output)     do_aa_output ;;
    aa-capture)    do_aa_capture ;;
    speedlimit-mode) do_speedlimit_mode ;;
    speedlimit-status) do_speedlimit_status ;;
    restore)    do_restore ;;
    status)     do_status ;;
    *) fail "UNKNOWN_ACTION_$ACTION" ;;
esac
exit 0
